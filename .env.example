# Hedera
HEDERA_OPERATOR_ID= 
HEDERA_OPERATOR_KEY= 
HEDERA_NETWORK=testnet

# Passport token (created once)
PASSPORT_TOKEN_ID=0.0.1234567
AUDIT_TOPIC_ID=0.0.7654321
DIRECTORY_TOPIC_ID=0.0.8765432
A2A_TOPIC_ID=0.0.9999999
MARKET_TOPIC_ID=0.0.8888888

# x402
x402_FACILITATOR_URL=https://api.testnet.blocky402.com
x402_FEE_PAYER=0.0.7162784
x402_TREASURY=0.0.8011510

# L402 (Lightning HTTP 402)
# Test mode generates mock macaroons + test invoices and accepts any preimage.
# For production: set L402_LND_URL and L402_LND_MACAROON to connect to an LND node.
L402_AMOUNT_SATS=100
L402_TEST_MODE=true
# L402_ROOT_KEY=<32-byte hex string for macaroon signing>
# L402_LND_URL=https://lnd.example.com:10009
# L402_LND_MACAROON=<hex-encoded admin macaroon>
# L402_NODE_PUBKEY=<node public key for invoice routing>

# IPFS
IPFS_API_KEY=...
IPFS_API_SECRET=...

# Server
PORT=4021
# Local:  http://localhost:4021
# Prod:   https://agent-passport-hedera.fly.dev
BASE_URL=http://localhost:4021

# Hermes demo agent (LOCAL ONLY — not pushed to Fly.io)
# Hermes is a demo agent that runs locally on port 4030.
# Other agents discover it via HERMES_ENDPOINT in the HCS directory.
HERMES_ACCOUNT_ID=0.0.7654321
HERMES_PRIVATE_KEY=0x...
HERMES_PORT=4030
HERMES_ENDPOINT=http://localhost:4030
MCP_SERVER_URL=http://localhost:4021

# Contact / Feedback (Discord + Telegram + Email)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
SUPPORT_EMAIL=support@agentbadge.xyz
RESEND_API_KEY=...

# DataHub (GMS REST API — same endpoints as mcp-server-datahub wraps)
DATAHUB_MCP_URL=http://localhost:4031
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
DATAHUB_TIMEOUT_MS=30000

# Stripe (fiat payments — SLICE-67-1)
# Test mode: sk_test_* keys from https://dashboard.stripe.com/test/apikeys
# Live mode: sk_live_* keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Base URL for checkout success/cancel redirects
PUBLIC_BASE_URL=http://localhost:4021
