/**
 * SLICE-201-10 (EPIC-201, трек A): demand-validation metrics collector.
 * Pulls board cards + journals and computes per-deal cycle metrics:
 *
 *   card createdAt → claim → submit → review(approve) → settle tx (payment leg)
 *
 * Cycle time = createdAt → last terminal journal entry (review txHash or
 * reject/cancel). Emits:
 *   hackathon/server/out/board-metrics.json   — machine-readable rows
 *   hackathon/server/out/METRICS.md           — markdown table
 *   docs/EPICS/201-agent-economy-interface/METRICS.md — epic copy (if dir exists)
 *
 * Usage:
 *   bun scripts/board-metrics.mts [--endpoint URL]
 * Env: CONF_ENDPOINT / E2E_TARGET_URL (default http://localhost:4021)
 */
const ENDPOINT = (
  process.env.CONF_ENDPOINT ??
  process.env.E2E_TARGET_URL ??
  "http://localhost:4021"
).replace(/\/+$/, "");
const OUT_MD = new URL("../out/METRICS.md", import.meta.url).pathname;
const OUT_JSON = new URL("../out/board-metrics.json", import.meta.url).pathname;
const EPIC_MD = new URL(
  "../../../docs/EPICS/201-agent-economy-interface/METRICS.md",
  import.meta.url,
).pathname;

const log = (...a: unknown[]) => console.log("[metrics]", ...a);

interface Card {
  cardId: string;
  title: string;
  column: string;
  budgetUsdc?: string;
  createdAt: string;
  assignedAgentId?: string;
}
interface Entry {
  kind: string;
  actor: string;
  txHash?: string;
  atMs: number;
}
interface Row {
  cardId: string;
  title: string;
  column: string;
  agent: string;
  budgetUsdc: string;
  createdAt: string;
  cycleDone: boolean;
  cycleSec: number | null;
  settleTx: string | null;
  events: number;
}

async function api(path: string) {
  const r = await fetch(`${ENDPOINT}${path}`);
  if (!r.ok) throw new Error(`${path} → ${r.status}`);
  return r.json() as Promise<Record<string, unknown>>;
}

async function cardsOf(column: string): Promise<Card[]> {
  const j = await api(`/api/board/cards?column=${column}`);
  return (j.cards as Card[] | undefined) ?? [];
}

async function journal(cardId: string): Promise<Entry[]> {
  const j = await api(`/api/board/cards/${cardId}/journal`);
  return (j.entries as Entry[] | undefined) ?? [];
}

const COLUMNS = ["todo", "claimed", "submitted", "review", "done", "rejected", "cancelled"];
const TERMINAL_KINDS = new Set(["review", "reject", "cancel", "claimRefund"]);

async function main() {
  const rows: Row[] = [];
  for (const col of COLUMNS) {
    let cards: Card[] = [];
    try {
      cards = await cardsOf(col);
    } catch (e) {
      log(`column ${col}: ${(e as Error).message}`);
      continue;
    }
    for (const c of cards) {
      const entries = await journal(c.cardId);
      const terminal = [...entries]
        .reverse()
        .find((e) => TERMINAL_KINDS.has(e.kind) && (e.txHash || col === "done" || col === "rejected" || col === "cancelled"));
      const created = Date.parse(c.createdAt);
      const cycleDone = c.column === "done" && !!terminal;
      const cycleSec =
        cycleDone && terminal ? Math.round((terminal.atMs - created) / 1000) : null;
      rows.push({
        cardId: c.cardId,
        title: c.title,
        column: c.column,
        agent: c.assignedAgentId ?? "-",
        budgetUsdc: c.budgetUsdc ?? "-",
        createdAt: c.createdAt,
        cycleDone,
        cycleSec,
        settleTx: terminal?.txHash ?? null,
        events: entries.length,
      });
    }
  }
  rows.sort((a, b) => a.createdAt.localeCompare(b.createdAt));

  const done = rows.filter((r) => r.cycleDone);
  const avg =
    done.length > 0
      ? Math.round(done.reduce((a, r) => a + (r.cycleSec ?? 0), 0) / done.length)
      : null;

  const md = [
    `# Demand Validation Metrics — SLICE-201-10`,
    ``,
    `Auto-generated by \`scripts/board-metrics.mts\` — ${new Date().toISOString()}`,
    `Endpoint: ${ENDPOINT}`,
    ``,
    `## Summary`,
    ``,
    `- **Cards**: ${rows.length}`,
    `- **Cycles completed**: ${done.length}`,
    `- **Avg cycle time**: ${avg !== null ? `${avg}s` : "n/a"}`,
    ``,
    `## Deals`,
    ``,
    `| Card | Title | Column | Agent | Budget | Cycle | Sec | Settle tx |`,
    `|------|-------|--------|-------|--------|-------|-----|-----------|`,
    ...rows.map(
      (r) =>
        `| ${r.cardId} | ${r.title.replace(/\|/g, "\\|")} | ${r.column} | ${r.agent} | ${r.budgetUsdc} | ${r.cycleDone ? "✔" : "✘"} | ${r.cycleSec ?? "-"} | ${r.settleTx ?? "-"} |`,
    ),
    ``,
    `## Notes`,
    ``,
    `- Cycle time = card createdAt → terminal journal entry (review/reject/cancel with txHash).`,
    `- External-builder rows are added by the demand-validation runs (D-201-14 gate).`,
    `- **Mainnet gate (D-201-14)**: mainnet deals are BLOCKED until ≥1 external`,
    `  builder completes a full testnet cycle end-to-end (see DEMAND-PLAYBOOK.md).`,
  ].join("\n");

  const { mkdirSync, existsSync } = await import("node:fs");
  const { dirname } = await import("node:path");
  mkdirSync(dirname(OUT_JSON), { recursive: true });
  await Bun.write(OUT_MD, md);
  if (existsSync(dirname(EPIC_MD))) await Bun.write(EPIC_MD, md);
  await Bun.write(
    OUT_JSON,
    JSON.stringify(
      {
        endpoint: ENDPOINT,
        generatedAt: new Date().toISOString(),
        summary: { cards: rows.length, cyclesDone: done.length, avgCycleSec: avg },
        rows,
      },
      null,
      2,
    ),
  );
  log(`${rows.length} cards, ${done.length} done, avg=${avg}s → ${OUT_MD}`);
}

await main();
