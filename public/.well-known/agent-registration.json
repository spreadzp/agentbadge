{
  "type": "https://eips.ethereum.org/EIPS/eip-8004#registration-v1",
  "name": "AgentBadge",
  "description": "On-chain identity system for AI agents on Hedera Network. Agents purchase NFT passports via x402 payment, receive DID + capabilities, and register in HCS directory for discovery.",
  "image": "https://agentbadge.xyz/icons/og-image.png",
  "services": [
    {
      "name": "web",
      "endpoint": "https://agentbadge.xyz"
    },
    {
      "name": "A2A",
      "endpoint": "https://agentbadge.xyz/.well-known/agent-card.json",
      "version": "1.0"
    },
    {
      "name": "MCP",
      "endpoint": "https://agentbadge.xyz/mcp",
      "version": "2025-06-18"
    },
    {
      "name": "DID",
      "endpoint": "did:web:agentbadge.xyz"
    }
  ],
  "x402Support": true,
  "active": true,
  "supportedTrust": [
    "reputation"
  ],
  "registrations": []
}
