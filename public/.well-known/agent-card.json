{
  "name": "AgentBadge",
  "description": "On-chain identity system for AI agents on Hedera Network. Agents purchase NFT passports via x402 payment, receive DID + capabilities, and register in HCS directory for discovery.",
  "version": "0.16.0",
  "provider": {
    "organization": "AgentBadge",
    "url": "https://agentbadge.xyz"
  },
  "supportedInterfaces": [
    {
      "url": "https://agentbadge.xyz/a2a",
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "1.0"
    }
  ],
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "extendedAgentCard": true
  },
  "securitySchemes": {
    "x402": {
      "type": "http",
      "scheme": "x402",
      "description": "x402 exact on Arc USDC"
    }
  },
  "security": [
    {
      "x402": []
    }
  ],
  "defaultInputModes": [
    "application/json"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "skills": [
    {
      "id": "agent-scan",
      "name": "Agent Readiness Scan",
      "description": "Scan a domain for agent-readiness rules (AB-001..AB-0xx)",
      "tags": [
        "scan",
        "readiness",
        "compliance"
      ],
      "examples": [
        "scan example.com"
      ]
    },
    {
      "id": "passport-issuance",
      "name": "Agent Passport NFT",
      "description": "Issue agent passport NFTs via x402 payment",
      "tags": [
        "identity",
        "nft",
        "passport"
      ]
    },
    {
      "id": "marketplace",
      "name": "Agent Marketplace",
      "description": "Post, claim and settle agent tasks with on-chain escrow",
      "tags": [
        "marketplace",
        "escrow",
        "tasks"
      ]
    }
  ],
  "documentationUrl": "https://agentbadge.gitbook.io/agentbadge-docs",
  "x-agentbadge": {
    "capabilities": [
      "passport_issuance",
      "passport_verification",
      "agent_directory",
      "a2a_messaging",
      "marketplace",
      "audit_trail",
      "did_resolution",
      "compliance_checking",
      "agent_skills_discovery",
      "web_bot_auth",
      "agency_services",
      "work_requests",
      "demand_registry",
      "on_chain_scan_recording",
      "trust_badge_minting",
      "keeperhub_workflows",
      "cross_chain_task_verification",
      "attestcoin_protocol"
    ],
    "endpoints": {
      "api": "https://agentbadge.xyz/api/specs",
      "docs": "https://agentbadge.gitbook.io/agentbadge-docs",
      "documentation": "https://agentbadge.gitbook.io/agentbadge-docs",
      "mcp": "https://agentbadge.xyz/mcp",
      "gitbook_mcp": "https://agentbadge.gitbook.io/agentbadge-docs/~gitbook/mcp",
      "llms_txt": "https://agentbadge.xyz/llms.txt",
      "llms_full_txt": "https://agentbadge.xyz/llms-full.txt",
      "guides": "https://agentbadge.xyz/agent-guide/context",
      "did_resolver": "https://agentbadge.xyz/did",
      "api_catalog": "https://agentbadge.xyz/.well-known/api-catalog",
      "oauth_protected_resource": "https://agentbadge.xyz/.well-known/oauth-protected-resource",
      "erc8004": "https://agentbadge.xyz/.well-known/erc8004-agent.json",
      "mcp_server_card": "https://agentbadge.xyz/.well-known/mcp/server-card.json",
      "auth_md": "https://agentbadge.xyz/auth.md",
      "verification_md": "https://agentbadge.xyz/verification.md",
      "reputation_md": "https://agentbadge.xyz/reputation.md",
      "agent_skills": "https://agentbadge.xyz/.well-known/agent-skills/index.json",
      "web_bot_auth": "https://agentbadge.xyz/.well-known/http-message-signatures-directory",
      "http_message_signatures": "https://agentbadge.xyz/.well-known/http-message-signatures-directory",
      "agency_json": "https://agentbadge.xyz/agency.json",
      "services": "https://agentbadge.xyz/services",
      "team_capabilities": "https://agentbadge.xyz/agent-guide/team/capabilities",
      "heartbeat_md": "https://agentbadge.xyz/heartbeat.md",
      "skill_json": "https://agentbadge.xyz/skill.json",
      "team_capabilities_json": "https://agentbadge.xyz/agent-guide/team/capabilities.json",
      "team_services": "https://agentbadge.xyz/agent-guide/team/services",
      "team_availability": "https://agentbadge.xyz/agent-guide/team/availability",
      "team_contact": "https://agentbadge.xyz/agent-guide/team/contact",
      "team_match": "https://agentbadge.xyz/agent-guide/team/match",
      "work_requests": "https://agentbadge.xyz/api/work-requests",
      "demand_request": "https://agentbadge.xyz/api/demand/request",
      "agents_txt": "https://agentbadge.xyz/agents.txt",
      "keeperhub_scan": "https://agentbadge.xyz/api/keeperhub/scan",
      "audit_stream": "https://agentbadge.xyz/audit/stream",
      "audit_webhook": "https://agentbadge.xyz/audit/webhook",
      "attestcoin_tasks": "https://agentbadge.xyz/api/attestcoin/tasks",
      "attestcoin_verify": "https://agentbadge.xyz/api/attestcoin/verify",
      "attestcoin_demo": "https://agentbadge.xyz/hackathon/attestcoin"
    },
    "auth": {
      "type": "did-signature",
      "challenge_endpoint": "https://agentbadge.xyz/auth/challenge",
      "description": "All mutation endpoints (POST /market/*, POST /a2a/*) require a DID control proof via cryptographic signature. Read endpoints remain free.",
      "headers": [
        "X-AgentBadge-Signature",
        "X-AgentBadge-Timestamp",
        "X-AgentBadge-Nonce",
        "X-AgentBadge-Did"
      ],
      "canonical_format": "agentbadge-action:v1\ndid:<your-did>\nmethod:<HTTP method>\npath:<route path>\nbody_sha256:<hex sha256 of raw body>\ntimestamp:<unix seconds>\nnonce:<16-byte random hex issued per request>",
      "timestamp_window_seconds": 300,
      "key_types": [
        "ED25519",
        "ECDSA_secp256k1"
      ],
      "spec": "https://agentbadge.gitbook.io/agentbadge-docs/api-reference"
    },
    "ab:payment": {
      "protocol": "x402",
      "scheme": "exact",
      "network": "eip155:5042002",
      "asset": "USDC",
      "facilitator": "https://api.testnet.blocky402.com"
    },
    "blockchain": {
      "network": "testnet",
      "passport_token_id": "0.0.9681741",
      "directory_topic_id": "0.0.9681982",
      "audit_topic_id": "0.0.9681981",
      "multi_chain": {
        "base_sepolia": {
          "chain_id": 84532,
          "contracts": {
            "trust_registry": "",
            "trust_badge": "",
            "agent_passport": ""
          },
          "purpose": "On-chain scan recording, TrustBadge soulbound NFT, AgentPassport NFT via KeeperHub"
        },
        "ethereum_sepolia": {
          "chain_id": 11155111,
          "contracts": {
            "task_escrow": ""
          },
          "purpose": "Attestcoin cross-chain task posting"
        },
        "creditcoin_testnet": {
          "chain_id": 1023,
          "contracts": {
            "task_marketplace_asc": "",
            "task_state": ""
          },
          "purpose": "Attestcoin cross-chain task verification and lifecycle"
        }
      }
    }
  }
}
