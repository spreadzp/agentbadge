{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbadge.xyz/schemas/process/v1/DocumentArtifact.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "document-artifact/1"
    },
    "documentType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "contentDigest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "value": {
          "type": "string",
          "pattern": "^(0x)?[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    },
    "uri": {
      "type": "string",
      "maxLength": 512,
      "format": "uri"
    },
    "mimeType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z]+\\/[a-z0-9][a-z0-9.+-]*$"
    },
    "issuer": {
      "$ref": "https://agentbadge.xyz/schemas/process/v1/ActorRef.schema.json"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "signature": {
      "type": "object",
      "properties": {
        "scheme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(0x)?[0-9a-fA-F]+$"
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "documentType",
    "contentDigest",
    "uri",
    "mimeType",
    "issuer",
    "issuedAt"
  ],
  "additionalProperties": false
}
