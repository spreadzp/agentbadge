{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbadge.xyz/schemas/process/v1/PolicyRef.schema.json",
  "type": "object",
  "properties": {
    "policyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "uri": {
      "type": "string",
      "maxLength": 512,
      "format": "uri"
    },
    "hash": {
      "type": "string",
      "pattern": "^(0x)?[0-9a-fA-F]{64}$"
    }
  },
  "required": [
    "version",
    "uri",
    "hash"
  ],
  "additionalProperties": false
}
