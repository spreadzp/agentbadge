{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbadge.xyz/schemas/process/v1/ProcessEventProjection.schema.json",
  "type": "object",
  "properties": {
    "projectionVersion": {
      "type": "string",
      "const": "process-event-projection/1"
    },
    "sourceEvent": {
      "type": "object",
      "properties": {
        "spec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "spec",
        "id",
        "source",
        "sourceId",
        "seq"
      ],
      "additionalProperties": false
    },
    "interpretation": {
      "type": "object",
      "properties": {
        "workflowRef": {
          "type": "object",
          "properties": {
            "workflowId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
            },
            "version": {
              "type": "string",
              "minLength": 5,
              "maxLength": 64,
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*)?(\\+[0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*)?$"
            }
          },
          "required": [
            "workflowId",
            "version"
          ],
          "additionalProperties": false
        },
        "stepType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
        },
        "subjectRefs": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "$ref": "https://agentbadge.xyz/schemas/process/v1/AssetRef.schema.json"
          }
        },
        "actorRefs": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "$ref": "https://agentbadge.xyz/schemas/process/v1/ActorRef.schema.json"
          }
        },
        "domainData": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 64,
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*)?(\\+[0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*)?$"
        },
        "status": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "AMBIGUOUS"
          ]
        },
        "issues": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "ACTOR_UNRESOLVED",
                  "ASSET_REF_MISSING",
                  "TYPE_UNKNOWN",
                  "AMBIGUOUS_SOURCE"
                ]
              },
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "adapter",
        "version",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "projectionVersion",
    "sourceEvent",
    "interpretation",
    "mapping"
  ],
  "additionalProperties": false
}
