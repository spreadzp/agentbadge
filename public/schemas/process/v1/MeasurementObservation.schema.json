{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbadge.xyz/schemas/process/v1/MeasurementObservation.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "measurement-observation/1"
    },
    "subjectAssetRef": {
      "$ref": "https://agentbadge.xyz/schemas/process/v1/AssetRef.schema.json"
    },
    "deviceRef": {
      "$ref": "https://agentbadge.xyz/schemas/process/v1/ActorRef.schema.json"
    },
    "property": {
      "type": "string",
      "enum": [
        "weight",
        "temperature",
        "humidity",
        "pressure",
        "dimension",
        "other"
      ]
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^-?(0|[1-9]\\d*)(\\.\\d+)?$"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "sequenceNumber": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previousRecordHash": {
      "type": "string",
      "pattern": "^(0x)?[0-9a-fA-F]{64}$"
    },
    "signature": {
      "type": "object",
      "properties": {
        "scheme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(0x)?[0-9a-fA-F]+$"
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "additionalProperties": false
    },
    "trustLevel": {
      "type": "string",
      "enum": [
        "DECLARED",
        "SIGNED_DEVICE",
        "SECURE_DEVICE",
        "CALIBRATED_DEVICE",
        "INDEPENDENTLY_VERIFIED"
      ]
    }
  },
  "required": [
    "schema",
    "subjectAssetRef",
    "deviceRef",
    "property",
    "value",
    "unit",
    "observedAt",
    "sequenceNumber",
    "signature",
    "trustLevel"
  ],
  "additionalProperties": false
}
