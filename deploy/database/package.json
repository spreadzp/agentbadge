{
  "name": "@agentbadge/database",
  "version": "0.6.18",
  "description": "Shared database layer for AgentBadge — Prisma ORM 8 client, repositories, store abstraction",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "author": "AgentBadge",
  "license": "MIT",
  "keywords": [
    "database",
    "postgres",
    "prisma",
    "agentbadge"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run --run",
    "db:up": "docker compose up -d postgres valkey",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:plan": "prisma migration plan",
    "db:migrate": "prisma db migrate --advance-ref db",
    "db:migrate:prod": "bash scripts/migrate-prod.sh",
    "db:verify": "prisma db verify",
    "db:seed": "bun run scripts/seed.ts",
    "postinstall": "prisma skills sync || exit 0"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.4.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^2.0.0",
    "bun-types": "^1.3.14",
    "prisma": "8.0.0-rc.15",
    "typescript": "^5.9.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@agentbadge/econ-events": "^0.1.3",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "dotenv": "^18.0.3"
  }
}
