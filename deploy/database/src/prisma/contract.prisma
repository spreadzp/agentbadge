model Event {
  id        String            @id @default(uuid())
  type      String
  payload   Json
  source    String?
  wallet    String?
  venueId   String?
  at        BigInt?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([type, createdAt])
  @@index([wallet, at])
  @@index([venueId, at])
}

model ScanResult {
  id             String            @id @default(uuid())
  domain         String
  url            String
  score          Int?
  report         Json
  rulesetVersion String?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([domain, createdAt])
}

model ChatSubscription {
  id        String            @id @default(uuid())
  chatId    BigInt            @unique
  username  String            @unique
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model VenueJob {
  id        String            @id @default(uuid())
  jobId     String            @unique
  status    String
  client    String
  provider  String?
  payload   Json
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([status, createdAt])
  @@index([client])
}

model VenueOffer {
  id              String            @id
  providerAddress String
  active          Boolean           @default(true)
  payload         Json
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([providerAddress, active])
}

model VenueMeta {
  key       String            @id
  value     Json
  updatedAt temporal.updatedAtString()
}

model AgentWallet {
  id           String            @id @default(uuid())
  address      String            @unique
  agentId      String?
  venueId      String?
  label        String
  kind         String
  registeredBy String
  active       Boolean           @default(true)
  // EPIC-176 owner controls — queryable mirror of payload fields
  suspended        Boolean  @default(false)
  suspendedAt      BigInt?
  suspendedBy      String?
  approvalAboveUsd Decimal?
  maxTxPerHour     Int?
  maxAmountPerHour Decimal?
  allowedKinds     Json?
  payload      Json
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([venueId, active])
  @@index([agentId])
  @@index([active, createdAt])
}

model SpendEvent {
  id           String            @id
  wallet       String
  venueId      String?
  kind         String
  amountUsd    Decimal
  state        String
  refId        String
  txHash       String?
  sourceChain  String?
  denialReason String?
  at           BigInt
  payload      Json
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([wallet, at])
  @@index([txHash])
  @@index([venueId, at])
  @@index([state, at])
  @@index([denialReason, at])
}

// EPIC-176-11: durable parked-intent permits. Domain timestamps are
// epoch-ms int8 with Ms suffix so createdAt/updatedAt stay the
// conventional temporal audit columns (SpendEvent precedent: `at`).
model SpendApproval {
  id           String   @id
  wallet       String
  venueId      String?
  amountUsd    Decimal
  kind         String
  refId        String
  state        String   @default("pending")
  decidedBy    String?
  decidedAtMs  BigInt?
  consumedAtMs BigInt?
  expiresAtMs  BigInt
  createdAtMs  BigInt
  // EPIC-257-4 (D-257-Q6): counterparty-holds bind the permit to one deal.
  // Typed column because the dedup constraint indexes it — approvalReason /
  // fingerprintVersion / meta ride inside payload instead.
  dealFingerprint String?
  payload      Json
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([wallet, state])
  @@index([wallet, createdAtMs])
  // At most ONE live pending per (wallet, dealFingerprint) — the
  // find-or-create backstop; NULLs never conflict (PG unique semantics).
  @@index([wallet, dealFingerprint], unique: true, where: "(state = 'pending')")
}

model DelegateRecord {
  id           String            @id
  ownerWallet  String
  delegate     String
  chain        String
  spendCapUsd  Decimal
  authorizedAt BigInt
  revokedAt    BigInt?
  payload      Json
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([ownerWallet])
  @@index([revokedAt])
}

