}

model MarketplaceService {
  serviceId String            @id
  payload   Json
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ─── EPIC-197: Agent Bounties ────────────────────────────────
// Queryable columns only for what routes/sweepers filter on —
// everything else rides in `payload` (catalog precedent).

model Bounty {
  bountyId     String            @id
  status       String // open|claimed|submitted|passed|failed|rejected
  onchainJobId String? // active ERC-8183 job; provider=0x0 until claim
  jobAttempt   Int               @default(1) // one job = one attempt (Q37/Q38-A)
  budgetUsdc   Decimal?
  createdBy    String?
  payload      Json
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([status, createdAt])
  @@index([onchainJobId])
}

model BountyClaim {
  id           String            @id @default(uuid())
  bountyId     String
  jobAttempt   Int
  passportId   String
  payoutWallet String
  state        String            @default("open") // open|expired|consumed
  claimedAtMs  BigInt
  leaseUntilMs BigInt
  payload      Json
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([bountyId, jobAttempt])
  @@index([passportId, createdAt])
  @@index([state, leaseUntilMs])
}

model BountyTransition {
  id       String            @id @default(uuid())
  bountyId String
  actor    String
  from     String
  to       String
  reason   String?
  atMs     BigInt
  payload  Json
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([bountyId, atMs])
}

model BountyOutcome {
  id             String            @id @default(uuid())
  bountyId       String
  jobAttempt     Int
  passportId     String?
  verdict        String // pass|fail|timeout
  reasonCodes    Json?
  verdictMemoTx  String?
  verdictRejectTx String?
  commitSha      String?
  payload        Json
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([bountyId, jobAttempt])
  @@index([passportId, createdAt])
  @@index([verdict, createdAt])
}

// O7: AgentPassportNFT has no ERC721Enumerable — owners indexed from
// Transfer events; row = latest observed owner per passport.
model PassportOwner {
  passportId  String            @id
  owner       String
  blockNumber BigInt
  logIndex    Int?
  payload     Json
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([owner])
}

model MarketplaceMeta {
  hash      String            @id
  payload   Json
  createdAt TimestamptzString @default(now())
}

// ─── EPIC-199: Arc Task Board ────────────────────────────────────
// BoardCard = bounty + board metadata, 1:1 with Bounty (no @@relation —
// store is pluggable json|prisma, integrity enforced by tests).
// `column` is a denormalized materialized column; source of truth is the
// BoardEntry journal — reconciler alerts on drift (never auto-fixes).
// specHash is immutable: written at create, never updated (D-199-4).
model BoardCard {
  cardId            String            @id // board-<ulid>
  bountyId          String            @unique // → Bounty.bountyId (1:1)
  column            String // todo|in_progress|testing|review|done|bug|cancelled
  title             String
  budgetUsdc        Decimal?
  specHash          String // keccak256(spec) — immutable after create
  createdBy         String? // ops actor
  currentPassportId String? // passport of the active executor
  fixDeadlineMs     BigInt? // Bug column: fix-resubmit TTL (199-09)
  payload           Json // spec, labels, escrow refs
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  @@index([column, createdAt]) // board listing per column
  @@index([currentPassportId]) // "my tasks" in agent cabinet
  @@index([fixDeadlineMs]) // sweeper: expired Bug deadlines
}

// Append-only board journal — audit + source of truth for column
// reconciliation (BountyTransition analogue, but board events not
// lifecycle transitions). INSERT only, unique(cardId, seq).
model BoardEntry {
  id        String            @id @default(uuid())
  cardId    String
  seq       Int // monotonic per card
  attempt   Int               @default(1)
  kind      String // create|claim|submit|qa|review|bug|reopen|done|cancel|rating|note
  actor     String // passportId|reviewer wallet|"ops"|"sweeper"|"qa"
  txHash    String?
  payload   Json // signatures, reasonCodes, score
  atMs      BigInt
  createdAt TimestamptzString @default(now())

  @@unique([cardId, seq])
  @@index([cardId, atMs])
  @@index([kind, atMs])
}

// Universal ERC-8004 reputation write ledger (absorbs 197-13).
// Idempotent: unique(sourceType, sourceId, jobAttempt) — retry never
// duplicates giveFeedback. venue-jobs and board-cards share the table,
// sourceType distinguishes the channel.
model ReputationWrite {
  id           String            @id @default(uuid())
  sourceType   String // "board"|"venue"
  sourceId     String // cardId | venue jobId
  jobAttempt   Int               @default(1)
  passportId   String
  agentId      String? // ERC-8004 id; null → onchain skip (ledger-only)
  score        Int // board: max(0,5-(attempt-1)); venue: +1/-1
  status       String // pending|sent|skipped|failed
  feedbackUri  String? // data:application/json proof package
  feedbackHash String?
  txHash       String? // giveFeedback tx
  attempts     Int               @default(0) // retry counter
  payload      Json
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([sourceType, sourceId, jobAttempt])
  @@index([passportId, createdAt]) // agent reputation aggregate
  @@index([status, updatedAt]) // retry-worker: failed → resend
  @@index([agentId])
}

// Outbox queue for ops-signer chain transactions (D-199-7).
// Source of truth for retry after crash/reject; audit journal.
// idempotencyKey unique → retry never duplicates an onchain write;
// crash between journal and tx shows as `pending` for the worker.
model ChainTxOutbox {
  id             String            @id @default(uuid())
  kind           String // createJob|setProvider|fund|submit|complete|
  //                        // reject|claimRefund|giveFeedback
  cardId         String? // → BoardCard (null for venue giveFeedback)
  jobAttempt     Int?
  idempotencyKey String            @unique // "board:{cardId}:{attempt}:{kind}"
  status         String // pending|sent|confirmed|failed
  txHash         String?
  attempts       Int               @default(0)
  lastError      String?
  payload        Json // call args, gas, nonce
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([status, createdAt]) // worker: pending/failed → resend
  @@index([cardId])
}

// EPIC-203: A2A v1.0 protocol — durable task/message/artifact store for the
// passport tier (D-203-4, D-203-11). Anonymous-tier tasks live ONLY in Redis
// with TTL — no model, never anchored (self-cleaning anti-spam).
// Postgres rows are NEVER deleted after anchoring (D-203-12): anchoredAt /
// anchorSeq flag the Merkle batch proof; task + artifacts are never pruned.
model A2ATask {
  id           String            @id @default(uuid())
  contextId    String // A2A context — groups tasks in a conversation
  status       String // submitted|working|completed|failed|canceled|input-required|rejected|auth-required
  ownerAgentId String // ERC-8004 agentId of the owning/passport agent (tenant isolation: foreign taskId → 404)
  tenant       String // venue/tenant namespace
  anchoredAt   BigInt? // epoch-ms when the Merkle batch anchor tx confirmed
  anchorSeq    BigInt? // position inside the anchored batch
  payload      Json // full SDK Task shape — queryable cols above are the mirror
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([contextId])
  @@index([tenant, ownerAgentId])
  @@index([anchoredAt])
}

model A2AMessage {
  id          String            @id @default(uuid())
  taskId      String // → A2ATask.id
  role        String // user|agent
  partsJson   Json // A2A Message.parts (text/file/data parts)
  fromAgentId String? // sender agentId (null for anonymous tier originators)
  toAgentId   String? // recipient agentId — passport ext inbox/outbox
  readAt      BigInt? // epoch-ms mark-read (passport ext, D-203-13)
  createdAt   TimestamptzString @default(now())

  @@index([taskId])
  @@index([toAgentId, readAt])
  @@index([fromAgentId])
}

model A2AArtifact {
  id        String            @id @default(uuid())
  taskId    String // → A2ATask.id
  name      String?
  partsJson Json // A2A Artifact.parts
  createdAt TimestamptzString @default(now())

  @@index([taskId])
}

// EPIC-204: payment-graph forensics index (SLICE-204-3).
// Append-only settle edges. unique(chain,txHash,payer,seller) keeps
// backfill re-runs and reorg retries idempotent — dup insert is a no-op.
model ForensicsEdge {
  id           String            @id @default(uuid())
  chain        String            // "5042" mainnet | "5042002" testnet
  payer        String            // lowercase 0x… — AuthUsed topics[1]
  seller       String            // lowercase 0x…
  amountAtomic BigInt            // USDC atomic units (decimals=6)
  txHash       String
  blockNumber  BigInt
  source       String            // chain|seam
  ts           BigInt            // block timestamp, epoch-sec
  createdAt    TimestamptzString @default(now())

  @@unique([chain, txHash, payer, seller])
  @@index([chain, seller, blockNumber])
  @@index([chain, payer])
}

// First-observed funding event per wallet — the forensics rule only
// looks at the FIRST funder. unique(chain,funded): indexer inserts the
// earliest funding; later events for the same wallet are dropped.
model ForensicsFunding {
  id             String            @id @default(uuid())
  chain          String
  funded         String            // lowercase 0x…
  funder         String            // lowercase 0x…
  txHash         String
  blockNumber    BigInt
  isPublicSource Boolean           @default(false)
  sourceKind     String?           // exchange|bridge|custody_provider|contract
  createdAt      TimestamptzString @default(now())

  @@unique([chain, funded])
  @@index([chain, funder])
}

// Indexer progress — one row per chain, upserted at each committed batch.
// Resume = read lastBlock; advisory-lock on the batch tx (143 pattern).
model ForensicsCursor {
  id        String   @id @default(uuid())
  chain     String   @unique
  lastBlock BigInt
  updatedAt temporal.updatedAtString()
}

// TG archive pipeline watermark (EPIC-217, D-217-8): one row per
// stream — "traffic-daily" | "traffic-weekly" | "forensics-weekly" |
// custom. throughAt = exclusive upper bound (unix ms) of the last
// window sent to Telegram; committed ONLY after a successful send
// (at-least-once — a failed send leaves the cursor behind and the
// window retries on the next tick). No FKs — autonomous table.
model ArchiveCursor {
  id            String   @id @default(uuid())
  stream        String   @unique
  throughAt     BigInt
  lastMessageId BigInt?
  note          String?
  updatedAt     temporal.updatedAtString()
}

// ─── EPIC-207: Economic Event ledger (SLICE-207-2) ────────────────
// Append-only SoT for agent economic facts. Typed core columns mirror
// @agentbadge/econ-events EconomicEvent; kind-specific data rides in
// `payload`. unique(idempotencyKey) → dedupe→duplicate:true on retry.
// ledgerSeq = global append order (serial) — stable cursor for scan();
// per-stream order is (source, sourceId, seq), also unique.
// NO update/delete paths in repositories — append-only enforced.
model EconomicEvent {
  ledgerSeq      BigInt   @default(autoincrement())
  id             String   @id
  spec           String
  source         String
  sourceId       String
  seq            Int
  kind           String
  actor          String
  counterparty   String?
  amountUsdc     Decimal?
  at             String            // ISO-8601 UTC (canonical event clock)
  idempotencyKey String   @unique  // ev:{source}:{sourceId}:{seq}
  payload        Json
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([source, sourceId, seq])
  @@unique([ledgerSeq])
  @@index([actor, ledgerSeq])
  @@index([counterparty, ledgerSeq])
  @@index([kind, ledgerSeq])
}

// SLICE-207-4 (D-207-5): eager materialized trust-graph projection.
// One row per (fromAgent, toAgent, kind) — updated in the SAME
// transaction as the event append (appendInTx hook). The event log is
// the source of truth; this table is a rebuildable fold — never store
// authoritative fields here that are absent from the log.
model AgentTrustEdge {
  id          String   @id @default(uuid())
  fromAgent   String   // event.actor
  toAgent     String   // event.counterparty (events without one make no edge)
  kind        String   // canonical event kind (work_accept, deliver, pay, verify, …)
  eventCount  Int      // fold: +1 per event
  totalUsd    Decimal  // fold: += amountUsdc (0 when absent)
  firstEventAt String? // `at` of the lowest-ledgerSeq contributing event (207-5 API needs firstAt); null until first rebuild
  firstEventSeq BigInt? // fold: min(ledgerSeq)
  lastEventAt String   // `at` of the highest-ledgerSeq contributing event
  lastEventSeq BigInt  // fold: max(ledgerSeq)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@unique([fromAgent, toAgent, kind])
  @@index([toAgent, lastEventSeq])
}

// ─── EPIC-220: Payment Infrastructure Foundation (SLICE-220-2) ───────
// Unified payment domain: Product/Price catalog projection + Payment
// intent + per-rail PaymentAttempt + immutable PaymentReceipt +
// append-only PaymentEvent audit. Money = Decimal (never float);
// domain epoch-ms timestamps use Ms-suffix BigInt columns; typed
// columns only for queryable filters — full entity rides in `payload`.
//
// Entity-level idempotency (D-220-8):
// - Payment.reference @unique — business-level dedupe
// - Payment.idempotencyKey @unique — client Idempotency-Key dedupe
// - Attempt @@unique(provider, providerReference) — provider-side dedupe
// - Attempt @@unique(provider, transactionHash) — replay protection
// - Receipt @@unique(provider, externalReference) — evidence dedupe
// Status transitions are domain-controlled (@agentbadge/payments);
// repos persist only via expected-from guarded ops — no UPDATE in
// the wild (D-220-6, spec 0.4).

model PaymentProduct {
  id          String            @id @default(uuid())
  code        String            @unique // service-catalog SKU (D-220-5)
  name        String
  description String?
  category    String // PASSPORT|SUBSCRIPTION|API_ACCESS|SCANNER|VERIFICATION|TASK|CUSTOM
  active      Boolean           @default(true)
  payload     Json
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([category, active])
  @@index([active])
}

model PaymentPrice {
  id          String            @id @default(uuid())
  productId   String // → PaymentProduct.id
  amount      Decimal // USD decimal, string-serialized at the edge
  currency    String            @default("USD")
  billingType String // ONE_TIME|RECURRING|USAGE_BASED
  interval    String? // MONTH|YEAR
  active      Boolean           @default(true)
  payload     Json
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([productId, active])
}

model Payment {
  id             String            @id
  reference      String            @unique // business-level reference
  idempotencyKey String?           @unique // client Idempotency-Key
  customerId     String?
  agentId        String?
  productId      String?
  orderId        String?
  amount         Decimal // USD decimal-string at the edge
  currency       String            @default("USD")
  status         String // PENDING|PROCESSING|CONFIRMED|FAILED|EXPIRED|REFUNDED|DISPUTED
  purpose        String // PASSPORT|SUBSCRIPTION|API_USAGE|TASK|CUSTOM
  expiresAtMs    BigInt? // domain expiry deadline (D-220-12 lazy+sweeper)
  createdAtMs    BigInt // domain timestamp from @agentbadge/payments entity
  updatedAtMs    BigInt // last controlled-transition timestamp
  payload        Json
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([status, createdAtMs])
  @@index([customerId])
  @@index([agentId])
  @@index([productId])
  @@index([orderId])
  @@index([expiresAtMs]) // expiry sweeper
}

model PaymentAttempt {
  id                String            @id
  paymentId         String // → Payment.id
  provider          String // STRIPE|DIRECT_USDC|X402|HEDERA
  network           String? // eip155:8453, stripe, ...
  token             String?
  amount            Decimal // in `currency` units, decimal-string at edge
  currency          String // USD|USDC
  status            String // CREATED|PENDING|PROCESSING|CONFIRMED|FAILED|EXPIRED
  providerReference String? // Stripe session id / provider payment id
  transactionHash   String?
  expiresAtMs       BigInt?
  confirmedAtMs     BigInt?
  payload           Json
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  @@unique([provider, providerReference])
  @@unique([provider, transactionHash])
  @@index([paymentId])
  @@index([status, expiresAtMs]) // expiry sweeper
  @@index([transactionHash])
}

// Immutable payment evidence — append-only, never updated/deleted.
model PaymentReceipt {
  id                String            @id
  paymentId         String
  attemptId         String
  provider          String
  externalReference String
  network           String?
  transactionHash   String?
  payer             String?
  recipient         String?
  amount            Decimal
  asset             String
  verifiedAtMs      BigInt
  payload           Json // verificationData rides here
  createdAt         TimestamptzString @default(now())

  @@unique([provider, externalReference])
  @@index([paymentId])
  @@index([attemptId])
  @@index([transactionHash])
}

// 222-4: durable ops/reconciliation exception queue. Append-only
// facts; lifecycle OPEN → RESOLVED|IGNORED.
model PaymentException {
  id             String            @id
  paymentId      String?
  attemptId      String?
  kind           String // failureReason enum + RECONCILIATION_MISMATCH
  severity       String // INFO|WARN|CRITICAL
  details        Json? // {expected, actual, txHash, block, payer, …}
  status         String // OPEN|RESOLVED|IGNORED
  createdAtMs    BigInt
  resolvedAtMs   BigInt?
  resolutionNote String?
  createdAt      TimestamptzString @default(now())

  @@index([status, createdAtMs])
  @@index([paymentId])
  @@index([attemptId])
  @@index([kind])
}

// Append-only audit of every controlled state transition (spec 0.4).
model PaymentEvent {
  id        String            @id
  entity    String // PAYMENT|PAYMENT_ATTEMPT
  paymentId String
  attemptId String?
  from      String
  to        String
  actor     String
  reason    String?
  atMs      BigInt
  payload   Json
  createdAt TimestamptzString @default(now())

  @@index([paymentId, atMs])
  @@index([attemptId, atMs])
  @@index([entity, atMs])
}

// 223-1: per-paid-request usage record written by the x402 gateway for
// every settled call (spec 3.5 — mandatory). Append-only; requestId is
// the idempotency anchor deduping client retries (D-223-3).
model UsageRecord {
  id           String            @id
  paymentId    String // → Payment.id
  agentId      String? // payer-binding resolution; null when unbound (D-223-6)
  resource     String // paid-resource id, e.g. "passport-request"
  requestId    String            @unique // per-request idempotency anchor
  amount       Decimal // USDC atomic units, decimal-string at edge
  currency     String            @default("USDC")
  network      String // CAIP-2, e.g. eip155:1874
  payerAddress String
  txHash       String?
  createdAtMs  BigInt
  payload      Json
  createdAt    TimestamptzString @default(now())

  @@index([paymentId])
  @@index([agentId, createdAtMs])
  @@index([resource, createdAtMs])
  @@index([payerAddress])
  @@index([txHash])
}

// 208-1c (D-208-39): internal analytics for rescue CLI runs. Minimal,
// no PII, no secrets — schema-validated + rate-limited at the route.
// public registry (208-8) is a separate explicit-approval flow.
model RescueTelemetryEvent {
  id           String   @id @default(uuid())
  executionId  String?  // optional — telemetry never requires it
  routeFrom    String
  routeTo      String
  asset        String
  amountUsdc   String   // raw base units; no Decimal to keep ingest trivial
  status       String
  txHashes     Json     // {approve?, burn?, mint?, refuel?}
  cliVersion   String
  ref          String?
  uaHash       String?  // sha256(ua) truncated — no raw UA (PII hygiene)
  createdAt    TimestamptzString @default(now())

  @@index([routeTo, createdAt])
  @@index([status, createdAt])
}

// ─── EPIC-252: Agent Request Inbox (SLICE-252-1) ──────────────────
// Free async mailbox for agents (D-252-Q1). State vocabulary is
// A2A-compatible: submitted|working|completed|failed.
//
// - fpHash = sha256(ip+ua+env-salt) — typed column because it keys the
//   idempotency pair (D-252-Q5) and the 252-2 rate-limit. The full
//   fingerprint snapshot (ua/referer/src/headers minus secrets) rides in
//   `fingerprint` Json. Raw IP is NEVER stored.
// - (idempotencyKey, fpHash) unique → client retry dedupe; rows without a
//   key keep key=null so they always create new records (Postgres treats
//   NULLs as distinct — the dedupe check is the app-level findByIdempotency).
// - expiresAtMs: row TTL — janitor hard-deletes expired rows (410 contract).
// - payload purge: janitor nulls `payload` on completed/failed rows older
//   than retention (metadata/state/response/fingerprint stay).
model AgentRequest {
  id             String            @id @default(uuid())
  state          String // submitted|working|completed|failed
  kind           String?
  payload        Json? // ≤256KB original prompt — purged by janitor
  fingerprint    Json  // {ua, referer, src, headers} — secrets stripped
  fpHash         String
  agentId        String?
  verified       Boolean           @default(false)
  response       Json?
  spamFlag       Boolean           @default(false)
  // D-256-Q13: opt-in consent to publish the completed Q&A into the
  // public corpus. Default false — in-flight rows stay unlisted.
  publishToQa    Boolean           @default(false)
  idempotencyKey String?
  expiresAtMs    BigInt
  createdAtMs    BigInt
  respondedAtMs  BigInt?
  // ─── EPIC-228 (D-228-10): interaction surface on the shared inbox
  // row — absorb-not-duplicate. All nullable: rows submitted through
  // the legacy /api/requests intake simply carry NULLs (channel=NULL).
  actorResolution String? // ANON|API_KEY|DID — D-228-1
  actorRef        String? // agentId|did — nullable: anon + retention (O-228-4)
  sessionId       String? // InteractionSession grouping key (A2A contextId, D-228-2)
  channel         String? // ingress channel; NULL = pre-228 /api/requests intake
  // Operator classification (D-228-5) — written only via admin surface:
  intent          String? // CAPABILITY_DISCOVERY|INTEGRATION_HELP|BUG_REPORT|PAYMENT_METHOD|FEATURE_REQUEST|OTHER
  signalType      String? // INTEREST|NEED|INTENT|PURCHASE
  outcome         String?
  knowledgeGap    Boolean            @default(false)
  topics          Json?
  entities        Json?
  demandSignals   Json?
  classifiedBy    String? // operatorRef of the last classification
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([idempotencyKey, fpHash])
  @@index([state, createdAt])
  @@index([fpHash])
  @@index([agentId])
  @@index([expiresAtMs])
  @@index([sessionId])
  @@index([actorRef])
  @@index([actorResolution])
}

// ─── EPIC-228: Agent Interaction Core (D-228-2/4/5, D-228-10) ──────
// The interaction domain rides on the shared agentRequest row; these
// tables carry what agentRequest cannot: session grouping, operator
// response records and the append-only event log. No FK constraints
// (project convention) — indexes only.

// D-228-2: grouping key without lifecycle (A2A contextId semantics).
// Client may supply its own id; otherwise server-minted uuid. Auto-
// upserted on every interaction submit — no open/close/TTL.
model InteractionSession {
  id            String            @id @default(uuid())
  actorRef      String?
  firstSeenAtMs BigInt
  lastSeenAtMs  BigInt
  requestCount  Int               @default(0)
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([actorRef])
}

// Operator answers (A7). One row per respond action — the request's
// legacy `response` Json column is dual-written {answer: body} for
// /api/requests GET + QA-corpus compat (D-228-10).
model InteractionResponse {
  id          String            @id @default(uuid())
  requestId   String
  operatorRef String
  body        String
  createdAtMs BigInt
  createdAt   TimestamptzString @default(now())

  @@index([requestId])
}

// D-228-4/8: append-only interaction log — no update/delete by API
// shape. visibility: PUBLIC rows are the only ones an agent may ever
// see; INTERNAL carries classification, ops notes, review markers.
// (requestId, seq) is the hard per-request ordering invariant.
// Events intentionally survive their request row (janitor hard-delete)
// — append-only audit; event-side retention is O-228-4.
model InteractionEvent {
  id          String            @id @default(uuid())
  requestId   String
  seq         Int
  kind        String // interaction.request.received|classified|response.sent|review.required
  visibility  String // PUBLIC|INTERNAL
  payload     Json
  createdAtMs BigInt
  createdAt   TimestamptzString @default(now())

  @@unique([requestId, seq])
  @@index([kind])
}

// Open surveys agents can answer (D-252-Q6). `questions` Json holds the
// survey definition; rating lands in ReputationWrite (existing model) only
// for verified agents — anonymous answers stay unrated.
model AgentSurvey {
  id         String            @id @default(uuid())
  title      String
  questions  Json
  active     Boolean           @default(true)
  closesAtMs BigInt?
  createdAtMs BigInt
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([active, createdAt])
}

// One answer row per (surveyId, agentId); anonymous answers dedupe
// app-level on (surveyId, fpHash) — nullable unique columns can't.
model SurveyAnswer {
  id          String            @id @default(uuid())
  surveyId    String
  agentId     String?
  fpHash      String?
  softFpHash  String?
  answers     Json
  rated       Boolean           @default(false)
  flag        String?
  createdAtMs BigInt
  createdAt   TimestamptzString @default(now())

  @@unique([surveyId, agentId])
  @@index([surveyId, fpHash])
  @@index([surveyId, softFpHash])
}

// D-252-Q7: accumulated Q&A corpus — materialized when a request reaches
// `completed`. questionHash = sha256(normalized question). The corpus
// survives payload purge (it is the value, not a copy of the prompt).
// v1 = exact/normalized hash + substring search; embeddings are phase 2.
model AgentQAPair {
  id              String            @id @default(uuid())
  questionHash    String            @unique
  question        String // normalized question text
  response        Json
  sourceRequestId String
  uses            Int               @default(0)
  // D-256-Q14: soft retract — record + reason kept for audit; retracted
  // pairs are excluded from search AND the intake fast-path.
  retractedAtMs   BigInt?
  retractReason   String?
  createdAtMs     BigInt
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([question])
  @@index([sourceRequestId])
}

// ─── EPIC-224: Agent Commerce (SLICE-224-1) ────────────────────
// Task/Offer/Agreement/Submission/Evidence/Event/Payment for
// agent↔human↔provider commerce. Actors are EVM wallets
// (lowercase) — canonical actor id (D-224-3); *AgentId columns are
// the optional Passport link. Money = Decimal (decimal-string at
// the edge, never float). No escrow: CommercePayment is
// RECORD_ONLY (D-224-4/D-224-15). market.ts / GEC rails untouched
// (D-224-6). Arc-only — no HCS/Hedera (D-224-13).

model CommerceTask {
  id            String            @id @default(uuid())
  buyerWallet   String // EVM lowercase — canonical actor (D-224-3)
  buyerAgentId  String? // optional Passport link
  title         String
  description   String
  requirements  Json? // spec Task.requirements record
  budget        Decimal? // USD decimal; null = zero-budget OK
  currency      String            @default("USD")
  maxProviders  Int               @default(1) // D-227: parallel provider slots
  expiresAtMs   BigInt? // informational only — manual cancel (D-224-12)
  status        String // DRAFT|OPEN|IN_PROGRESS|SUBMITTED|UNDER_REVIEW|COMPLETED|CANCELLED
  payload       Json
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([status, createdAt])
  @@index([buyerWallet, createdAt])
  @@index([buyerAgentId])
}

model CommerceOffer {
  id              String            @id @default(uuid())
  taskId          String // → CommerceTask.id
  providerWallet  String
  providerAgentId String?
  price           Decimal // decimal-string at edge
  currency        String            @default("USD")
  eta             String? // spec estimatedDuration
  proposal        String
  status          String // PENDING|ACCEPTED|REJECTED|WITHDRAWN
  payload         Json
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([taskId, status])
  @@index([providerWallet, createdAt])
}

model CommerceAgreement {
  id                 String            @id @default(uuid())
  taskId             String // → CommerceTask.id; ≤maxProviders per task (D-227)
  offerId            String            @unique // accepted offer → agreement
  buyerWallet        String
  providerWallet     String
  agreedAmount       Decimal
  currency           String            @default("USD")
  acceptanceCriteria Json?
  status             String // ACTIVE|COMPLETED|CANCELLED|DISPUTED
  completedAtMs      BigInt?
  payload            Json
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  @@index([taskId])
  @@index([buyerWallet])
  @@index([providerWallet])
  @@index([status])
}

model CommerceSubmission {
  id             String            @id @default(uuid())
  agreementId    String // → CommerceAgreement.id
  providerWallet String
  summary        String // ≤4000 chars — contract guard (EPIC-206)
  resultUrl      String?
  milestoneRef   String? // → settlement Milestone.id (D-227)
  status         String // SUBMITTED|ACCEPTED|REJECTED|REVISION_REQUIRED
  reviewNote     String?
  submittedAtMs  BigInt
  reviewedAtMs   BigInt?
  payload        Json
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([agreementId, createdAt])
  @@index([status])
  @@index([providerWallet])
  @@index([milestoneRef])
}

// Append-only evidence rows (D-224-11: FILE = url+sha256 only).
model CommerceEvidence {
  id           String            @id @default(uuid())
  submissionId String? // spec primary anchor
  agreementId  String? // or agreement-level evidence
  type         String // URL|FILE|HASH|TRANSACTION|API_RESPONSE|ATTESTATION
  url          String?
  hash         String? // sha256 (FILE/HASH) or txHash (TRANSACTION)
  content      String? // API_RESPONSE snippet etc.
  metadata     Json?
  payload      Json
  createdAt    TimestamptzString @default(now())

  @@index([submissionId])
  @@index([agreementId])
  @@index([type])
}

// Append-only hash-chain journal (D-224-7, EPIC-172 pattern):
// eventSeq gives total order; hash = hashCanonical(prevHash ‖ entry).
model CommerceEvent {
  eventSeq    BigInt            @default(autoincrement())
  id          String            @id
  entityType  String // task|offer|agreement|submission|evidence|payment
  entityId    String
  eventType   String // e.g. task.created, offer.accepted
  actorWallet String?
  prevHash    String // genesis sentinel on first row
  hash        String
  payload     Json
  createdAt   TimestamptzString @default(now())

  @@unique([eventSeq])
  // SLICE-224-6 / H7: one row per chain predecessor — concurrent
  // emitters on the same entity stream cannot both append (fork).
  @@unique([entityType, entityId, prevHash])
  @@index([entityType, entityId, eventSeq])
  @@index([hash])
  @@index([eventType, eventSeq])
}

// RECORD_ONLY payment mirror (D-224-4/D-224-15): payment status is
// independent of task status. paymentId links to Payment.id only in
// future AGENTBADGE_CHECKOUT mode.
model CommercePayment {
  id           String            @id @default(uuid())
  agreementId  String            @unique // one payment record per agreement
  mode         String            @default("RECORD_ONLY")
  status       String // NOT_PAID|PAYMENT_RECORDED|PAYMENT_VERIFIED
  amount       Decimal?
  currency     String            @default("USD")
  paymentId    String? // future → Payment.id (checkout mode)
  recordedBy   String?
  recordedAtMs BigInt?
  verifiedBy   String?
  verifiedAtMs BigInt?
  note         String?
  payload      Json
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([status])
}

// ─── EPIC-226: Admin FinOps (SLICE-226-1) ──────────────────────────
// Admin dashboard persistence: append-only AdminAction audit trail
// (D-226-3), RefundIntent manual-complete work queue (D-226-4),
// ReconciliationException resolve flow (D-226-6). Money = Decimal
// (decimal-string at the edge, never float); domain epoch-ms use
// Ms-suffix BigInt columns. Typed columns only for queryable filters.

// Append-only audit of EVERY manual admin action — written before/with
// the effect (spec: audit trail always). No update/delete path.
model AdminAction {
  id          String            @id @default(uuid())
  action      String // REVIEW|RETRY_VERIFY|MARK_EXTERNAL_REVIEWED|REFUND|RESOLVE_EXCEPTION|DETECT_EXCEPTIONS
  subjectType String // payment|attempt|receipt|exception|refund_intent|agreement
  subjectId   String
  operator    String // normalized label — post-264-7 it holds principal.id verbatim
  principalId String? // credential-resolved principal.id (op_*); NULL = pre-migration rows (D-264-Q13)
  evidence    Json? // free-form refs: txHash, url, note, report link
  createdAtMs BigInt // domain timestamp
  createdAt   TimestamptzString @default(now())

  @@index([subjectType, subjectId, createdAtMs])
  @@index([action, createdAtMs])
  @@index([operator, createdAtMs])
}

// Manual refund work queue (D-226-4): Stripe refunds complete
// automatically via provider API; on-chain (USDC/x402) refunds are
// intents completed manually with a real verified txHash — never a
// fabricated confirmation.
model RefundIntent {
  id            String            @id @default(uuid())
  paymentId     String // → Payment.id
  payee         String // destination wallet
  amount        Decimal // decimal-string at the edge
  currency      String            @default("USDC")
  reason        String
  evidence      Json?
  status        String // OPEN|COMPLETED
  txHash        String? // completion proof — verified on-chain read upstream
  operator      String // creator label
  createdAtMs   BigInt
  completedAtMs BigInt?
  completedBy   String?
  payload       Json
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([paymentId])
  @@index([status, createdAtMs])
  @@index([payee])
  @@unique([txHash])
}

// Persistent reconciliation work queue (D-226-6). Deterministic ids
// dedupe re-scans; OPEN → RESOLVED with resolution enum + resolvedBy —
// every resolve also emits an AdminAction (service layer).
model ReconciliationException {
  id           String            @id
  type         String // AMOUNT_MISMATCH|MISSING_TX|ORPHAN_TX|REVERTED
  subjectRef   String // paymentId | txHash
  details      Json?
  status       String // OPEN|RESOLVED
  resolution   String? // MATCHED|IGNORED|MANUAL_ADJUSTED|REFUNDED
  resolvedBy   String?
  resolvedAtMs BigInt?
  createdAtMs  BigInt
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([status, createdAtMs])
  @@index([type, createdAtMs])
  @@index([subjectRef])
}

// ─── EPIC-225: Identity, Entitlements & Reputation (SLICE-225-1) ──
// Actor = single table keyed by wallet (D-225-3): canonical actor id is
// the EVM wallet (lowercase); nullable links to ERC-8004 agentId,
// passport token, DID and org are enrichment — never required for
// participation (spec: external executors without Passport).
// Entitlement = grant layer only (D-225-2); ServicePass stays the
// enforcement surface. ReputationFact = append-only verifiable facts
// (D-225-5) — never an opaque score.

model Actor {
  wallet          String            @id // EVM wallet lowercase — canonical key (D-225-3)
  type            String // REGISTERED_USER|REGISTERED_AGENT|EXTERNAL_AGENT|EXTERNAL_HUMAN|ORGANIZATION
  agentId         String? // ERC-8004 id (EPIC-184/190)
  passportTokenId String?
  did             String?
  orgId           String?
  tier            String? // identity-tier association (not purchase — D-225-2)
  payload         Json
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([type, createdAt])
  @@index([agentId])
  @@index([orgId])
}

model Entitlement {
  id              String            @id @default(uuid())
  ownerId         String // → Actor.wallet
  productCode     String // catalog code: PASSPORT_BRONZE|READINESS_PREMIUM|API_ACCESS_*|MARKETPLACE_PARTICIPANT|MULTI_AGENT|...
  sourcePaymentId String? // → Payment.id — VERIFIED payments only (invariant)
  status          String // ACTIVE|EXPIRED|REVOKED
  validFromMs     BigInt
  validUntilMs    BigInt?
  idempotencyKey  String            @unique // sweeper dedupe (e.g. paymentId|productCode)
  // One ACTIVE row per (ownerId, productCode) enforced at DB level:
  // activeSlot = `ownerId|productCode` while status=ACTIVE, else null.
  activeSlot      String?           @unique
  payload         Json
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([ownerId, productCode, status])
  @@index([status, validUntilMs]) // expiry sweeper
  @@index([sourcePaymentId])
}

// Append-only verifiable facts (D-225-5): sourceRef points at an
// auditable record (agreementId, paymentId, verdictId, txHash) — the
// fact stays verifiable without a hash-chain of its own. dedupeKey
// makes emitters idempotent (sweeper retries, replays).
model ReputationFact {
  id          String            @id @default(uuid())
  actorWallet String // → Actor.wallet
  factType    String // TASK_COMPLETED|SUBMISSION_ACCEPTED|EVIDENCE_SUPPLIED|PAYMENT_VERIFIED|DISPUTE|ATTESTATION
  subjectId   String? // taskId/submissionId/evidenceId/...
  sourceRef   String // → auditable record
  dedupeKey   String            @unique // emitter idempotency
  atMs        BigInt // domain timestamp (insertion = createdAt)
  payload     Json
  createdAt   TimestamptzString @default(now())

  @@index([actorWallet, factType, createdAt])
  @@index([sourceRef])
  @@index([subjectId])
}

// ─── EPIC-227: A2A Settlement (SLICE-227-1) ─────────────────────────
// Settlement layer for agent commerce (D-227-1..8): milestone-structured
// payment with conditional release, PayoutIntent→legs completed by manual
// ops with a real txHash, disputes (manual arbitration), and memo anchors
// for settlement receipts. Money = Decimal (decimal-string at the edge,
// never float). agreementRef is an EXTERNAL reference — payment state is
// independent of task state (D-227-2); no FK into commerce tables.

// Ordered milestone structure for one agreement (D-227-3): sum of the
// milestones' amountUsd equals totalUsd — enforced by the domain layer
// at creation; the plan row carries the authoritative totals.
model MilestonePlan {
  id             String            @id @default(uuid())
  agreementRef   String            @unique // → CommerceAgreement.id (external ref)
  buyerWallet    String // EVM wallet
  providerWallet String // EVM wallet
  currency       String            @default("USDC")
  totalUsd       Decimal
  status         String // ACTIVE|DISPUTED|COMPLETED|CANCELLED
  payload        Json
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([buyerWallet])
  @@index([providerWallet])
  @@index([status])
}

model Milestone {
  id                 String            @id @default(uuid())
  planId             String // → MilestonePlan.id
  milestoneId        String // caller-chosen key — unique within the plan
  seq                Int // ordered-list position (flat ordered list, D-227-3)
  title              String
  amountUsd          Decimal
  acceptanceCriteria String?
  dueAtMs            BigInt?
  releasePolicy      String // BUYER_ACCEPT|EVALUATOR_VERDICT (seam O-227-4)
  status             String // PENDING|READY|APPROVED|RELEASED|DISPUTED|CANCELLED
  submissionRef      String? // milestone ↔ Submission 1:1
  escrowRef          String? // erc8183 seam (O-227-3)
  payload            Json
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  @@unique([planId, milestoneId])
  @@index([planId, seq])
  @@index([status])
}

// Manual-ops payout work queue (D-227-4): intent is created when a
// milestone is APPROVED; ops sends the transfers off-band and marks legs
// paid with the real txHash — never a fabricated confirmation. One
// intent per milestone (milestoneRef unique).
model PayoutIntent {
  id            String            @id @default(uuid())
  milestoneRef  String            @unique // → Milestone.id
  executor      String            @default("MANUAL") // MANUAL|WALLET_SERVICE (seam O-227-2)
  status        String // OPEN|FROZEN|COMPLETED|FAILED|CANCELLED
  createdAtMs   BigInt
  completedAtMs BigInt?
  completedBy   String? // operator label that closed the last leg
  payload       Json
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([status, createdAtMs])
}

// Payment leg (D-227-5): {payee, amountUsdc, role}; sum(legs) equals the
// milestone amount at intent creation. txHash is set-once — a completed
// leg is immutable (append-only proof).
model PayoutLeg {
  id            String            @id @default(uuid())
  intentId      String // → PayoutIntent.id
  payee         String // EVM wallet destination
  amountUsdc    Decimal
  role          String // PROVIDER|COLLABORATOR|PLATFORM_FEE
  status        String // OPEN|FROZEN|COMPLETED|FAILED
  txHash        String? // set-once on completion
  network       String            @default("arc") // replay key = network+hash
  completedAtMs BigInt?
  completedBy   String?
  payload       Json
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([intentId])
  @@index([status])
  @@index([payee])
  @@unique([network, txHash]) // one real tx binds at most one leg
}

// Manual-arbitration dispute (D-227-7): raising a dispute freezes the
// connected PayoutIntents; only an operator resolves (+ AdminAction in
// the service layer). resolverRef is the EaaS-verdict seam — evidence
// input, never an auto-resolution.
model Dispute {
  id           String            @id @default(uuid())
  subjectType  String // AGREEMENT|MILESTONE
  subjectRef   String // agreementId | Milestone.id
  raisedBy     String // participant wallet
  reason       String
  evidenceRefs Json // string refs ≤50 × ≤1000 (contract guards 206)
  status       String // OPEN|RESOLVED
  resolution   String? // FOR_BUYER|FOR_PROVIDER|SPLIT
  splitAmounts Json? // leg-level amounts for SPLIT
  resolvedBy   String?
  resolverRef  String? // EaaS verdict seam
  createdAtMs  BigInt
  resolvedAtMs BigInt?
  payload      Json
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([subjectType, subjectRef])
  @@index([status, createdAtMs])
}

// Memo-anchor outbox for settlement-receipt@1 (D-227-8): receiptHash
// anchored on Arc via a memo tx; ANCHORED only with the real txHash.
// Dedicated table (O-227-5 resolved): ChainTxOutbox is board-scoped
// (cardId/kind/idempotencyKey semantics do not fit).
model SettlementAnchor {
  id           String            @id @default(uuid())
  receiptRef   String            @unique // e.g. `${agreementId}:${milestoneId}`
  receiptHash  String // keccak256 of the canonical receipt body
  chainId      String
  txHash       String? // memo tx carrying the anchor — set-once
  status       String // PENDING|ANCHORED|FAILED
  attempts     Int               @default(0)
  lastError    String?
  anchoredAtMs BigInt?
  payload      Json
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([status])
}

// ─── EPIC-229: Knowledge Engine (D-229-1..9) ──────────────────────
// Operator-curated verified knowledge base — Postgres is the source
// of truth (D-229-1); file-based surfaces stay read-only projections.
// Agent reads are strictly status=PUBLISHED — enforced at the store
// seam, never by caller convention. No FK constraints (project
// convention) — indexes only; composites run inside db.transaction.

// D-229-1/2: the item is a stable shell; content lives in append-only
// KnowledgeVersion rows. latestVersionId tracks the newest draft,
// publishedVersionId the version agents may see — set ONLY by the
// workflow layer on VERIFIED→PUBLISHED, cleared on WITHDRAWN.
model KnowledgeItem {
  id                 String            @id @default(uuid())
  slug               String            @unique // ^[a-z0-9][a-z0-9-]{2,120}$
  kind               String // GUIDE|CONCEPT|FAQ|POLICY|CAPABILITY_DOC
  status             String // DRAFT|PENDING|VERIFIED|PUBLISHED|WITHDRAWN
  latestVersionId    String? // → KnowledgeVersion.id (newest draft)
  publishedVersionId String? // → KnowledgeVersion.id (agent-visible)
  createdBy          String // operatorRef of the creator
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  @@index([status, updatedAt])
  @@index([kind])
}

// D-229-2: append-only version history — rows are never updated or
// deleted. Restore = a NEW version copying an old one
// (restoredFromVersionId). (itemId, seq) unique is the per-item
// ordering invariant. The functional GIN index covers the 229-5 FTS
// query expression (contract-managed — no generated column, no drift).
model KnowledgeVersion {
  id                    String            @id @default(uuid())
  itemId                String // → KnowledgeItem.id
  seq                   Int
  title                 String
  body                  String
  summary               String?
  restoredFromVersionId String? // → KnowledgeVersion.id (restore-as-copy)
  createdBy             String // operatorRef
  createdAt             TimestamptzString @default(now())

  @@unique([itemId, seq])
  @@index([itemId])
  // D-229-4 / O-229-1: functional GIN FTS index over the exact
  // to_tsvector expression the search seam queries ('simple' config).
  @@index(
    expression: "to_tsvector('simple', \"title\" || ' ' || \"body\")",
    type: "gin",
    name: "knowledge_version_fts"
  )
}

// D-229-3: append-only audit of status transitions — written in the
// SAME transaction as the status flip (InteractionEvent precedent).
// `from` is NULL on the create event; transitions are human-only.
model KnowledgeStatusEvent {
  id        String            @id @default(uuid())
  itemId    String // → KnowledgeItem.id
  from      String? // NULL = initial create event
  to        String // DRAFT|PENDING|VERIFIED|PUBLISHED|WITHDRAWN
  actor     String // operatorRef
  reason    String?
  createdAt TimestamptzString @default(now())

  @@index([itemId, createdAt])
}

// D-229-5: capability registry — seeded from code sources (scanner
// checks, x402 packs, MCP tools, manifests) + manual operator entries.
// SEEDED rows start verified:true; MANUAL start verified:false.
model KnowledgeCapability {
  id          String            @id @default(uuid())
  name        String            @unique // e.g. "x402-settle", "mcp.verify"
  kind        String // SCANNER_CHECK|X402_PACK|MCP_TOOL|MANIFEST|MANUAL
  description String?
  source      String // SEEDED|MANUAL
  verified    Boolean           @default(false)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([kind])
  @@index([verified])
}

// D-229-5 m:n item↔capability — explicit join model (implicit m:n is
// rejected by the SQL interpreter); compound PK dedupes links.
model KnowledgeItemCapability {
  itemId       String // → KnowledgeItem.id
  capabilityId String // → KnowledgeCapability.id

  @@id([itemId, capabilityId])
  @@index([capabilityId])
}

// D-229-8: typed directed edges between ITEMS (not versions) — edges
// survive version churn. RELATED_TO reads both directions at query
// time; compound unique dedupes, lib layer bans self-loops and
// SUPERSEDES A→B / B→A cycles.
model KnowledgeRelation {
  id         String            @id @default(uuid())
  fromItemId String // → KnowledgeItem.id
  toItemId   String // → KnowledgeItem.id
  type       String // RELATED_TO|SUPERSEDES|DEPENDS_ON|PART_OF|CONTRADICTS
  createdBy  String // operatorRef
  createdAt  TimestamptzString @default(now())

  @@unique([fromItemId, toItemId, type])
  @@index([toItemId])
  @@index([type])
}

// D-229-9: typed evidence refs scoped on a VERSION (a new version may
// change the evidentiary base). Cap ≤50 refs/version enforced in the
// lib (D-206-5 analog); `uri` index supports itemsCiting(uri) lookups.
model KnowledgeEvidence {
  id        String            @id @default(uuid())
  versionId String // → KnowledgeVersion.id
  type      String // INTERNAL_DOC|EXTERNAL_URL|ONCHAIN_TX|API_ENDPOINT|SCAN_REPORT
  uri       String // ≤1000 — url-or-path
  label     String?
  addedBy   String // operatorRef
  createdAt TimestamptzString @default(now())

  @@index([versionId])
  @@index([uri])
}

// D-229-7: persisted unanswered-question gap — upserted on
// normalizedQuery (demand-registry: trim + lowercase + collapse ws).
// count/samples grow on repeat sightings; lifecycle is operator-driven.
// sourceRef ties INTERACTION_SIGNAL gaps back to the agentRequest row
// that flagged them (O-229-6 — ireq_*); NULL for other sources.
model KnowledgeGap {
  id              String            @id @default(uuid())
  normalizedQuery String            @unique // normalized dedupe key
  sampleQueries   Json // string[] verbatim agent texts — cap 10
  count           Int               @default(1)
  capabilityRef   String? // → KnowledgeCapability.name (attribution)
  intent          String? // INTERACTION_INTENTS value (228 classify)
  source          String // COMPOSER_REFUSAL|INTERACTION_SIGNAL|MANUAL
  sourceRef       String? // ireq_* for INTERACTION_SIGNAL (O-229-6)
  status          String // OPEN|TRIAGED|RESOLVED|WONTFIX
  linkedItemId    String? // → KnowledgeItem.id (set on RESOLVED)
  // EPIC-264 (264-10): ownership — assignee is a human AdminOperator
  // id; assignedBy the acting principal; dueAt absolute UTC (no
  // duration); resolvedAt stamps the RESOLVED transition (cleared
  // on reopen) for the time-to-clear metric.
  assignedTo      String?
  assignedBy      String?
  assignedAt      TimestamptzString?
  dueAt           TimestamptzString?
  resolvedAt      TimestamptzString?
  firstSeenAt     TimestamptzString @default(now())
  lastSeenAt      TimestamptzString @default(now())

  @@index([status, lastSeenAt])
  @@index([count])
  @@index([assignedTo, status])
  @@index([status, dueAt])
}

// ─── EPIC-264 (264-11): persisted gap audit — append-only event
// rows. assignedTo on the gap says WHO owns it now; these rows say
// who/when handed it over (and cover lifecycle actors that used to
// live only in non-persisted domain events). Written in the SAME tx
// as the gap mutation (KnowledgeStatusEvent precedent).
model KnowledgeGapEvent {
  id               String            @id @default(uuid())
  gapId            String // → KnowledgeGap.id
  kind             String // assigned|unassigned|reassigned|due_set|due_cleared|triaged|resolved|wontfix|reopened
  actor            String // principal.id (op_*); "system" on auto-reopen
  previousAssignee String? // who held it before (reassign/unassign chain)
  assignedTo       String? // new owner (null on unassigned)
  dueAt            TimestamptzString? // deadline after this event
  reason           String? // REQUIRED on due_* (C3 anti-laundering)
  occurredAt       TimestamptzString @default(now())
  createdAt        TimestamptzString @default(now())

  @@index([gapId, occurredAt])
}

// ─── EPIC-264 (264-13): durable overdue-breach records (C8) —
// the FACT a deadline was breached, persisted atomically by the
// sweeper independent of console visits; emittedAt=null marks a
// recorded-but-not-yet-signalled breach so a kill between record
// and emit is caught up by the next tick. (gapId,dueAt) unique →
// a renewed deadline after a breach is a NEW breach generation.
model KnowledgeGapOverdue {
  id         String            @id @default(uuid())
  gapId      String // → KnowledgeGap.id
  dueAt      TimestamptzString // the breached deadline
  detectedAt TimestamptzString @default(now()) // sweeper tick that caught it
  emittedAt  TimestamptzString? // NULL = record landed, emit pending

  @@unique([gapId, dueAt])
  @@index([emittedAt])
}

// ─── EPIC-230: Feedback & Review Infrastructure (D-230-1..9) ──────
// Two domains sharing the 228 conventions: actor tiers + actorRef,
// idempotent intake on (idempotencyKey, dedupeScope), append-only
// PUBLIC|INTERNAL event logs, no FK constraints (indexes only).
// Review is deliberately NOT an EaaS-verdict — the advisory decision
// lives in reviewDecision rows, no signature/onchain anchor.

// D-230-4: agent feedback — required `text` + optional typed fields
// the operator confirms/edits at triage. `normalized` is the
// auto-dedup key (normalized text+target): a repeat submission links
// to the canonical row via relatedFeedbackId and bumps its
// relatedCount; DUPLICATE stays an operator-applied status.
model Feedback {
  id                String            @id @default(uuid())
  actorResolution   String // ANON|API_KEY|DID — D-230-3
  actorRef          String? // agentId|did — NULL for anon + retention
  dedupeScope       String // actor scope for the idempotency unique pair
  idempotencyKey    String?
  text              String // ≤16KB
  kind              String? // BUG|FEATURE|DOCS|DX|OTHER
  target            String? // agent-guide|api|docs|venue|mcp|other
  severity          String? // hint LOW|MEDIUM|HIGH
  normalized        String // sha256(normalize(text)+target) — dedup key
  relatedCount      Int               @default(1)
  relatedFeedbackId String? // → canonical Feedback.id (NULL = canonical)
  suggestion        String? // operator short formulation
  status            String // RECEIVED|TRIAGED|ACCEPTED|DECLINED|DUPLICATE|CLOSED
  knowledgeConverted Boolean           @default(false)
  knowledgeItemId   String? // → KnowledgeItem.id (D-230-10 seam)
  createdAt         TimestamptzString @default(now())
  triagedAt         TimestamptzString?
  closedAt          TimestamptzString?
  updatedAt         temporal.updatedAtString()

  @@unique([idempotencyKey, dedupeScope])
  @@index([status, createdAt])
  @@index([normalized])
  @@index([actorRef])
  @@index([relatedFeedbackId])
}

// D-230-5: review case — a request for human review of the agent's
// work. PENDING_TRIAGE→IN_REVIEW→DECIDED + DECLINED (declineReason
// enum) + REOPENED→PENDING_TRIAGE with reopenCount for §17.3.
// assignee/claimedAt set on the IN_REVIEW transition; delivery is
// automatic at DECIDED (deliveredAt = decidedAt).
model ReviewCase {
  id                String            @id @default(uuid())
  actorResolution   String // ANON|API_KEY|DID
  actorRef          String?
  dedupeScope       String
  idempotencyKey    String?
  reviewType        String // API_SURFACE|DOCS|CODE_SNIPPET|INTEGRATION|OTHER
  workRef           String // uri — the work under review
  agentCriteria     Json? // string[] — agent wishes, never scored (D-230-6)
  status            String // PENDING_TRIAGE|IN_REVIEW|DECIDED|DECLINED|REOPENED
  assignee          String? // operatorRef — set on IN_REVIEW claim
  claimedAt         TimestamptzString?
  decidedAt         TimestamptzString?
  deliveredAt       TimestamptzString? // auto-delivery at DECIDED
  declineReason     String? // OUT_OF_SCOPE|SPAM|INSUFFICIENT_EVIDENCE|DUPLICATE|OTHER
  reopenCount       Int               @default(0)
  latestDecisionSeq Int? // → ReviewDecision.seq (append-only pointer)
  knowledgeConverted Boolean           @default(false)
  knowledgeItemId   String?
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  @@unique([idempotencyKey, dedupeScope])
  @@index([status, createdAt])
  @@index([actorRef])
  @@index([assignee])
  @@index([reviewType])
}

// D-230-7: typed two-sided evidence. AGENT rows are claims (§16.2 —
// submitted ≠ verified); OPERATOR rows are collected during
// IN_REVIEW. Cap ≤50/review enforced in the store (D-206-5 analog).
model ReviewEvidence {
  id          String            @id @default(uuid())
  reviewId    String // → ReviewCase.id
  type        String // EXTERNAL_URL|API_ENDPOINT|ONCHAIN_TX|REPO_LINK|ARTIFACT_REF|OTHER
  uri         String // ≤1000 — validated by the 229 classifier
  label       String?
  description String?
  submittedBy String // AGENT|OPERATOR
  createdAt   TimestamptzString @default(now())

  @@index([reviewId])
}

// D-230-8: append-only decisions — rows are never updated or
// deleted. REOPENED + re-decide appends seq+1; ReviewCase.
// latestDecisionSeq points at the newest. criteriaResults is the
// per-criterion snapshot of the platform template at decision time.
model ReviewDecision {
  id              String            @id @default(uuid())
  reviewId        String // → ReviewCase.id
  seq             Int
  outcome         String // APPROVED|APPROVED_WITH_NOTES|CHANGES_REQUESTED|REJECTED
  criteriaResults Json // [{key,result:PASS|FAIL|NA,note?}]
  summary         String
  decidedBy       String // operatorRef
  decidedAt       TimestamptzString @default(now())

  @@unique([reviewId, seq])
  @@index([reviewId])
}

// D-230-1 + D-228-4/8 convention: append-only domain event logs —
// no update/delete by API shape; (entityId, seq) is the ordering
// invariant. PUBLIC rows are the only ones an agent may ever see.
model FeedbackEvent {
  id         String            @id @default(uuid())
  feedbackId String
  seq        Int
  kind       String // feedback.received|triaged|accepted|declined|duplicate|closed|knowledge_converted
  visibility String // PUBLIC|INTERNAL
  payload    Json
  createdAt  TimestamptzString @default(now())

  @@unique([feedbackId, seq])
  @@index([kind])
}

model ReviewEvent {
  id         String            @id @default(uuid())
  reviewId   String
  seq        Int
  kind       String // review.received|claimed|evidence_added|decided|declined|reopened|knowledge_converted
  visibility String // PUBLIC|INTERNAL
  payload    Json
  createdAt  TimestamptzString @default(now())

  @@unique([reviewId, seq])
  @@index([kind])
}

// ─── EPIC-262 (SLICE-262-2) Agent Surface Intelligence — site registry.
// Tenant→Customer→Site→{Domains, Environment} per D-262-Q5. site_id is
// the stable technical identity: domain moves never rewrite it
// (D-262-Q9). Ownership is TWO independent scopes keyed @@unique(siteId,
// kind). Site keys persist hash+prefix only — plaintext never stored.

model IntelTenant {
  id        String            @id // tnt_<ulid>
  slug      String            @unique
  name      String
  status    String            @default("active") // active|suspended
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model IntelCustomer {
  id        String            @id // cus_<ulid>
  tenantId  String
  name      String
  status    String            @default("active") // active|suspended
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([tenantId])
}

model IntelSite {
  id          String            @id // site_<ulid> — survives domain moves
  customerId  String
  environment String            @default("production") // production|staging|development
  status      String            @default("active") // active|suspended|deleted
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([customerId])
}

model IntelDomain {
  id        String            @id // dom_<ulid>
  siteId    String
  hostname  String            @unique // globally claimed
  isPrimary Boolean           @default(false)
  status    String            @default("active") // active|removed
  createdAt TimestamptzString @default(now())

  @@index([siteId])
}

// Only hash+prefix persisted — plaintext exists once in the mint
// response. rotatedFromId keeps rotation lineage for audit.
model IntelSiteKey {
  id            String            @id // key_<ulid>
  siteId        String
  keyHash       String            @unique // sha256 hex
  keyPrefix     String // "absk_"+8 — identification only, no secret
  status        String            @default("active") // active|revoked
  rotatedFromId String?
  createdAt     TimestamptzString @default(now())
  revokedAt     TimestamptzString?

  @@index([siteId, status])
}

// D-262-Q9: two independent scopes — installation_control
// (plugin_handshake) | domain_control (dns_txt). reverifyAfter drives
// the re-verify scan (DNS ~90d orientir); meta-tag/file methods rejected
// at the service layer, not here.
model IntelOwnershipProof {
  id            String            @id // own_<ulid>
  siteId        String
  kind          String // installation_control|domain_control
  method        String // plugin_handshake|dns_txt
  status        String            @default("pending") // pending|verified|expired|revoked
  verifiedAt    TimestamptzString?
  reverifyAfter TimestamptzString?
  domainId      String? // set for domain_control proofs
  payload       Json?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@unique([siteId, kind])
  @@index([status, reverifyAfter])
}

// ─── EPIC-262 (SLICE-262-3) Canonical evidence envelope storage.
// The SIGNED envelope is kept verbatim (byte-exact for later
// verification); dedupeHash is the server-computed idempotency key;
// expiresAt is the transparent retention deadline (D-262-Q8).

model IntelEnvelope {
  id            String            @id // env_<ulid> — same as envelope_id
  schemaVersion String // "1.0"
  siteId        String
  scanId        String
  collectorId   String
  provenance    String // EXTERNAL_OBSERVED|PLUGIN_SELF_REPORTED|BACKEND_VERIFIED|DERIVED
  dedupeHash    String            @unique // sha256 hex — retry idempotency
  receivedAt    TimestamptzString // backend-stamped acceptance instant
  expiresAt     TimestamptzString? // receivedAt + retention days
  envelope      Json // full canonical envelope — signed, verbatim
  createdAt     TimestamptzString @default(now())

  @@index([siteId, receivedAt])
  @@index([scanId])
  @@index([expiresAt])
}

// ─── EPIC-262 (SLICE-262-19a) Tenant entitlement — the right to run
// paid operations (D-262-Q7: entitlement ≠ site_key ≠ consent). One
// row per tenant in v1; status transitions stay manual until 19b.
// coveredSiteIds/perSiteLimits are Json to keep the contract lean.

model IntelEntitlement {
  id             String            @id // ent_<ulid>
  tenantId       String            @unique // one entitlement per tenant (v1)
  plan           String // operator-managed plan code
  status         String // trial|active|past_due|expired|canceled
  coveredSiteIds Json // string[] — empty = all tenant sites
  perSiteLimits  Json // Record<string, number> — stored, enforced later
  validFrom      TimestamptzString
  validUntil     TimestamptzString // paid period end
  graceUntil     TimestamptzString // soft-off boundary (D-262-Q8)
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

// ─── EPIC-262 (SLICE-262-6) Hosted deep-scan job — the external scan
// lifecycle record (queued|running|complete|partial|failed). The
// signed canonical report is kept on the job row (v1); a dedicated
// report surface can index it later (D-262-Q6/Q8).

model IntelScanJob {
  id            String            @id // job_<ulid>
  siteId        String
  tenantId      String
  scanId        String // scan_<ulid> — shared with envelopes + report
  status        String // queued|running|complete|partial|failed
  baseUrl       String
  probeFailures Int               @default(0)
  probeTotal    Int               @default(0)
  error         String?
  reportId      String?
  report        Json? // signed canonical report — verbatim
  // SLICE-262-31: cross-surface trace id — was process-local until
  // 0.6.36 (same known-gap batch as the events tables)
  correlationId String?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
  finishedAt    TimestamptzString?

  @@index([siteId, createdAt])
  @@index([tenantId])
  @@index([scanId]) // attest route resolves scan_<ulid> → job
}

// ─── EPIC-262 (SLICE-262-11) Client monthly report — canonical
// snapshot (immutable, references the signed report by hash) +
// versioned editorial layer. Lifecycle GENERATED→IN_REVIEW→
// APPROVED→SENT; one report per site+period (D-UX-Q4).

model IntelClientReport {
  id               String            @id // cr_<ulid>
  siteId           String
  tenantId         String
  period           String // "YYYY-MM"
  status           String // GENERATED|IN_REVIEW|APPROVED|SENT
  canonical        Json // immutable snapshot — never edited
  delta            Json? // MoM delta — null = first period / ruleset change
  editorial        Json // current revision {version, heroLine, …}
  editorialHistory Json // archived revisions
  approvedBy       String?
  sentBy           String?
  sentAt           TimestamptzString?
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@unique([siteId, period])
  @@index([tenantId])
}

// ─── EPIC-262 (SLICE-262-7) Tenant operators — humans on a tenant
// with roles; the abop_ key is a TENANT-scoped credential (site owner
// ≠ operator ≠ tenant). Plaintext never persisted — sha256+prefix.

model IntelOperator {
  id        String            @id // op_<ulid>
  tenantId  String
  email     String // normalized lowercase
  role      String // owner|operator|viewer
  status    String            @default("active") // active|revoked
  keyHash   String            @unique // sha256 hex
  keyPrefix String // "abop_"+8 — identification only, no secret
  createdAt TimestamptzString @default(now())
  revokedAt TimestamptzString?

  @@unique([tenantId, email])
  @@index([tenantId, status])
}

// ─── EPIC-262 (SLICE-262-8) Consent — permission for a specific
// action, independent of entitlement/site_key (D-262-Q7); revocation
// stops paid ops even while subscribed (D-262-Q8). One row per
// (siteId, kind) — latest state wins, history lands with 262-23.

model IntelConsent {
  id                  String            @id // con_<ulid>
  siteId              String
  kind                String // audit (apply|publication later)
  status              String // granted|revoked
  grantedByPrincipal  String // site_key|operator
  grantedById         String // site_key_id | operator_id
  grantedAt           TimestamptzString
  revokedAt           TimestamptzString?
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()

  @@unique([siteId, kind])
  @@index([siteId])
}

// ─── EPIC-262 (SLICE-262-23) Consent events — append-only history of
// every grant/revoke including no-ops (a re-assertion is still a fact
// about what a principal did). The upserted IntelConsent row carries
// only latest state; this log is the audit trail. Process-local until
// 0.6.36.

model IntelConsentEvent {
  id          String            @id // cev_<ulid>
  siteId      String
  kind        String // audit|inside_diagnostics|apply|publication
  action      String // granted|revoked
  principal   String // site_key|operator|system (262-22 transfer reset)
  principalId String // site_key_id | operator_id | system:<reason>
  at          TimestamptzString
  createdAt   TimestamptzString @default(now())

  @@index([siteId, at])
}

// ─── EPIC-262 (SLICE-262-19b) Entitlement events — append-only log
// of every lifecycle transition (assign_plan|activate|renew|
// payment_failed|payment_recovered|expire|cancel|sweep_*|transfer_*).
// Billing state changes are auditable, never edits. Process-local
// until 0.6.36.

model IntelEntitlementEvent {
  id         String            @id // eev_<ulid>
  tenantId   String
  actor      String // operator:<id> | system:<source>
  action     String
  fromStatus String? // null on the first assign
  toStatus   String
  plan       String
  reason     String?
  at         TimestamptzString
  createdAt  TimestamptzString @default(now())

  @@index([tenantId, at])
}

// ─── EPIC-262 (SLICE-262-21) Billing events — provider webhook
// dedupe + audit. @@unique(provider, externalId) IS the idempotency
// mechanism: the insert either lands (first delivery) or conflicts
// (retry) — cross-instance safe unlike a process-local Set.

model IntelBillingEvent {
  id          String            @id // bev_<ulid>
  provider    String // stripe|freemius
  externalId  String // provider event id
  tenantId    String? // resolved binding; null when unmapped (422 still audited)
  effect      Json // normalized BillingSignal.effect verbatim
  applied     Boolean
  reason      String? // duplicate|unmapped|no_tenant_binding|…
  processedAt TimestamptzString
  createdAt   TimestamptzString @default(now())

  @@unique([provider, externalId])
  @@index([tenantId])
}
// principal model (D-264-Q2/Q3/Q17, C1, C11). Operator ≠ credential:
// issue/rotate/revoke touches credential rows, never the operator's
// identity. Shape borrowed from IntelOperator (262); no tenant/role —
// admin principals are instance-scoped, capability-scoped. No
// @@relation constraints — indexes only (house convention).

model AdminOperator {
  id            String              @id // op_<ulid>
  displayName   String // shown on consoles/audit instead of raw id
  principalType String // human|service|break_glass — security boundary (C11), never inferred from name
  capabilities  Json // string[] from ADMIN_CAPABILITIES closed vocab (read|probe|workflow|operator-admin)
  status        String              @default("active") // active|disabled
  createdAt     TimestamptzString   @default(now())
  disabledAt    TimestamptzString?

  @@index([principalType, status])
}

model AdminOperatorCredential {
  id         String            @id // opc_<ulid>
  operatorId String // → AdminOperator.id (no FK — index only)
  keyHash    String            @unique // sha256 hex of opk_ plaintext
  keyPrefix  String // "opk_"+8 — identification only, no secret
  status     String            @default("active") // active|revoked
  issuedAt   TimestamptzString @default(now())
  revokedAt  TimestamptzString?
  lastUsedAt TimestamptzString? // throttled touch — diagnostics, not auth

  @@index([operatorId, status])
  @@index([lastUsedAt])
}

// ─── EPIC-231: Demand Intelligence (D-231-1..5, O3) ──────────────
// Persisted demand pipeline: DemandSignal (append) → DemandCluster
// (mutable aggregate, upsert by clusterKey) → DemandOpportunity
// (operator lifecycle) + DemandEvent (append-only, same-tx emit).
// No FK constraints (house convention) — indexes only.
//
// Levels are a string enum: INTEREST < NEED < INTENT <
// PURCHASE_INTENT < VERIFIED_DEMAND. `declaredLevel` is what the
// signal SOURCE claimed — capped at PURCHASE_INTENT (D-231-3);
// `level` is the effective level, set only by deterministic system
// rules or an operator. An agent's own text can NEVER mint
// VERIFIED_DEMAND (§16.1): that level requires a payment/escrow
// fact, a confirmed deal, or an operator action.
//
// O3 (signal-text retention, §16): verbatim `context` is
// retention-bounded — `contextRetainUntil` is stamped at write time
// (default now+90d) and a retention janitor nulls `context` past it.
// `normalizedText` (trim+lower+collapse-ws) is retained: it is the
// dedup/clustering artifact the aggregate counts on, not a verbatim
// payload. Erasure on actorRef (GDPR/§16): the operator nulls
// `context` + `actorRef` via the same path — no auto-purge in v1.

model DemandSignal {
  id                 String            @id @default(uuid())
  source             String // DEMAND_API|INTERACTION|KNOWLEDGE_GAP|FEEDBACK (D-231-2)
  sourceRef          String? // originating row ref (agentRequest.id|KnowledgeGap.id|Feedback.id) — pull-model seams
  dedupeScope        String // actor scope for the idempotency unique pair (230 convention)
  idempotencyKey     String? // caller-supplied retry key
  normalizedText     String // trim+lower+collapse-ws — dedupe input, retained (O3)
  context            String? // verbatim caller context ≤1000 — retention-bounded (O3)
  contextRetainUntil TimestamptzString? // purge horizon — janitor nulls `context` past this
  category           String? // dictionary term (D-228-5 vocab); NULL = unclassified
  feature            String? // dictionary term (D-228-5 vocab)
  capabilityKey      String? // → KnowledgeCapability.name (229 registry)
  declaredLevel      String // INTEREST|NEED|INTENT|PURCHASE_INTENT — source claim, capped
  level              String // INTEREST|NEED|INTENT|PURCHASE_INTENT|VERIFIED_DEMAND — system/operator only
  actorResolution    String // ANON|API_KEY|DID (D-228-1)
  actorRef           String? // agentId|did|anon-bucket — NULL collapses to one unattributed actor in uniqueActors
  sessionId          String? // → InteractionSession.id
  dedupeKey          String // sha256(normalizedText+actorRef+window) — burst dedupe probe (D-231-4)
  relatedCount       Int                @default(1) // repeat count on the canonical row
  relatedSignalId    String? // → canonical DemandSignal.id (NULL = canonical)
  clusterId          String? // → DemandCluster.id
  createdAtMs        BigInt // domain timestamp (dedupe windows, metrics)
  createdAt          TimestamptzString  @default(now())

  @@unique([idempotencyKey, dedupeScope])
  @@index([dedupeKey])
  @@index([clusterId])
  @@index([source, createdAt])
  @@index([level])
  @@index([actorResolution, actorRef])
  @@index([category, feature])
  @@index([relatedSignalId])
}

// D-231-4: mutable aggregate — deterministic upsert by clusterKey =
// normalize(category+feature). count/uniqueActors/levelBreakdown are
// recounted over CANONICAL signals (relatedSignalId IS NULL): burst
// repeats link under relatedSignalId and never inflate demand
// (§13.2). `level` is the effective cluster level — monotone-max on
// signal level inside recordSignal, CAS-promoted by the level rules
// via applyClusterLevel. status: OPEN → TRIAGED → LINKED | DISMISSED.
model DemandCluster {
  id             String            @id @default(uuid())
  clusterKey     String            @unique // normalize(category+feature) — deterministic
  category       String?
  feature        String?
  capabilityKey  String? // → KnowledgeCapability.name
  count          Int               @default(0) // canonical signals attached
  uniqueActors   Int               @default(0) // distinct (actorResolution, actorRef)
  levelBreakdown Json // {"INTEREST":n,"NEED":n,...} over canonical signal.level
  level          String // effective cluster level (max promotion)
  status         String            @default("OPEN") // OPEN|TRIAGED|LINKED|DISMISSED
  firstSeenAt    TimestamptzString @default(now())
  lastSeenAt     TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([status, count])
  @@index([uniqueActors])
  @@index([level])
}

// D-231-5: operator-created product opportunity on a cluster —
// lifecycle PROPOSED → EVALUATING → ACCEPTED|DECLINED → LINKED →
// SHIPPED/CLOSED. metricsSnapshot freezes the cluster counters at
// proposal time; backlogTaskId is set by the «→ Backlog task»
// operator gesture (auto-creation of capabilities/tasks from demand
// is forbidden by spec — operator-only).
model DemandOpportunity {
  id              String            @id @default(uuid())
  clusterId       String // → DemandCluster.id
  status          String            @default("PROPOSED") // PROPOSED|EVALUATING|ACCEPTED|DECLINED|LINKED|SHIPPED|CLOSED
  title           String
  hypothesis      String?
  expectedValue   String?
  metricsSnapshot Json? // {count, uniqueActors, levelBreakdown, level} at proposal
  backlogTaskId   String? // set by «→ Backlog task» → status LINKED
  declineReason   String?
  createdBy       String // operatorRef
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
  closedAt        TimestamptzString?

  @@index([clusterId])
  @@index([status])
}

// D-231-1 + D-228-4/8 convention: append-only domain event log —
// no update/delete by API shape; (entityType, entityId, seq) is the
// ordering invariant. Events emit inside the same tx as the state
// change (EPIC-207). INTERNAL payload never reaches public
// projections (D-228-8). idempotencyKey carries the econ-ledger
// format ev:{source}:{sourceId}:{seq} — replay-safe standalone
// appends.
model DemandEvent {
  id             String            @id @default(uuid())
  entityType     String // signal|cluster|opportunity
  entityId       String
  seq            Int
  kind           String // demand.signal.created|demand.cluster.updated|demand.opportunity.*
  visibility     String // PUBLIC|INTERNAL
  payload        Json
  idempotencyKey String?           @unique // ev:{source}:{sourceId}:{seq}
  createdAt      TimestamptzString @default(now())

  @@unique([entityType, entityId, seq])
  @@index([kind])
  @@index([entityId])
}
