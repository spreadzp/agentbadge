vars: {
  d2-config: {
    sketch: true
  }
}

direction: right

Payer: {
  shape: person
  style.fill: "#E8F0FE"
  style.stroke: "#4285F4"
}

Server: {
  shape: rectangle
  style.fill: "#E8F5E9"
  style.stroke: "#4CAF50"
  "bind txHash to signer": {shape: text; style.font-size: 12}
}

Chain: {
  shape: cylinder
  style.fill: "#F3E5F5"
  style.stroke: "#9C27B0"
  "payment tx": {shape: text; style.font-size: 12}
}

Attacker: {
  shape: person
  style.fill: "#FFEBEE"
  style.stroke: "#F44336"
  "cannot claim with copied txHash": {shape: text; style.font-size: 11}
}

Payer -> Server: "1. request -> 402 challenge"
Payer -> Chain: "2. pay (txHash)"
Payer -> Server: "3. retry: txHash + X-Sig (EIP-191 over challenge)"
Server -> Chain: "4. verify tx sender == X-Sig signer"
Server -> Payer: "5. resource"
Attacker -> Server: "copied txHash, no matching X-Sig"
Server -> Attacker: "denied"
