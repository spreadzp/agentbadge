vars: {
  d2-config: {
    sketch: true
  }
}

direction: right

Client: {
  shape: person
  style.fill: "#E8F0FE"
  style.stroke: "#4285F4"
}

EaaS API: {
  shape: rectangle
  style.fill: "#E8F5E9"
  style.stroke: "#4CAF50"
  "policy gate: subscription | x402": {shape: text; style.font-size: 12}
  "eval pipeline (LLM + rules)": {shape: text; style.font-size: 12}
}

VerdictArtifact: {
  shape: document
  style.fill: "#FFF3E0"
  style.stroke: "#FF9800"
  "EIP-712 signed": {shape: text; style.font-size: 12}
  "offline-verifiable": {shape: text; style.font-size: 12}
}

Delivery: {
  shape: rectangle
  style.fill: "#ECEFF1"
  style.stroke: "#607D8B"
  "sync | webhook (HMAC) | pull feed": {shape: text; style.font-size: 12}
}

Memo contract: {
  shape: cylinder
  style.fill: "#F3E5F5"
  style.stroke: "#9C27B0"
  "artifactHash anchor": {shape: text; style.font-size: 12}
}

Client -> EaaS API: "POST /api/eaas/verdicts"
EaaS API -> VerdictArtifact: "evaluate + sign"
VerdictArtifact -> Delivery
Delivery -> Client: "verdict"
VerdictArtifact -> Memo contract: "anchor"
Client -> Memo contract: "verify (public)"
