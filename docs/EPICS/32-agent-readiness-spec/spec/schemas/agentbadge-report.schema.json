{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID — 26-char Crockford Base32, see spec §11"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "Literal version pin — only '0.1.0' accepted in v0.1"
    },
    "ruleset": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "agent-readiness",
          "description": "Ruleset name — always 'agent-readiness' in v0.1"
        },
        "version": {
          "type": "string",
          "const": "1.2.0",
          "description": "Ruleset semver — always '1.2.0' in v0.1"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "description": "Reference to the ruleset used for this scan"
    },
    "scope": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string",
          "description": "Unique identifier of the scanned agent (e.g. DID or hostname)"
        },
        "agent_version": {
          "type": "string",
          "description": "Version string of the scanned agent"
        },
        "endpoint_base_url": {
          "type": "string",
          "format": "uri",
          "description": "Base URL of the agent's primary HTTP endpoint"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "description": "ISO 8601 timestamp of when the scan was initiated"
        }
      },
      "required": [
        "agent_id",
        "agent_version",
        "endpoint_base_url",
        "timestamp"
      ],
      "additionalProperties": false,
      "description": "Scope of the scan — identifies what was scanned"
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "ISO 8601 timestamp of scan completion"
    },
    "previous_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "SHA-256 hash of the previous report for this scope, or null if first scan"
    },
    "source_state": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Fetched URL"
          },
          "etag": {
            "description": "ETag header from response, if present",
            "type": "string"
          },
          "last_modified": {
            "description": "Last-Modified header, if present",
            "type": "string"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
            "description": "ISO 8601 timestamp of fetch"
          },
          "status_code": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599,
            "description": "HTTP status code of the fetch"
          }
        },
        "required": [
          "url",
          "fetched_at",
          "status_code"
        ],
        "additionalProperties": false
      },
      "description": "Array of fetched resources — enables reproducibility, see spec §10"
    },
    "score": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Overall readiness score (0-100), weighted sum of category scores"
        },
        "categories": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "discovery",
              "documentation",
              "actionability",
              "machine_readable",
              "verification"
            ],
            "description": "Rule category: discovery, documentation, actionability, machine_readable, verification"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "required": [
            "discovery",
            "documentation",
            "actionability",
            "machine_readable",
            "verification"
          ],
          "description": "Per-category scores (0-100), keyed by category enum"
        },
        "delta": {
          "description": "Score change from previous report — omitted on first scan",
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "pillars": {
          "type": "array",
          "description": "Per-pillar scores (v0.2 additive, optional) — see spec v0.2 §11.1",
          "items": {
            "type": "object",
            "properties": {
              "pillar": {
                "type": "string",
                "enum": [
                  "discovery",
                  "understandability",
                  "executability",
                  "verifiability"
                ],
                "description": "Pillar enum — see spec v0.2 §A.7"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Pillar weight (default 20/25/30/25)"
              },
              "rawScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Raw pillar score before floor capping"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Final pillar score after floor capping"
              },
              "categoryCount": {
                "type": "integer",
                "minimum": 0,
                "description": "Number of categories mapped to this pillar"
              },
              "applicableCount": {
                "type": "integer",
                "minimum": 0,
                "description": "Number of applicable categories (NOT_APPLICABLE excluded)"
              },
              "floorTriggered": {
                "type": "boolean",
                "description": "Whether a floor cap was triggered on this pillar"
              }
            },
            "required": [
              "pillar",
              "weight",
              "rawScore",
              "score",
              "categoryCount",
              "applicableCount",
              "floorTriggered"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "total",
        "categories"
      ],
      "additionalProperties": false,
      "description": "Score block — see spec §6 for scoring model"
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^AB-[A-Z0-9-]+$",
            "description": "Stable rule identifier (e.g. 'AB-001', 'AB-007')"
          },
          "rule_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semver of this rule's own check logic — see spec §3"
          },
          "category": {
            "type": "string",
            "description": "Rule category — see spec §A.2 for category enum"
          },
          "status": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "INFERRED",
              "CONFLICT",
              "GAP",
              "MISSING",
              "NOT_APPLICABLE"
            ],
            "description": "Assertion status: VERIFIED (direct evidence), INFERRED (indirect, carries confidence), CONFLICT (sources disagree), GAP (no evidence found — canonical V2 name; MISSING accepted as legacy input alias, never emitted in new payloads), NOT_APPLICABLE (rule does not apply to this scope)"
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "Rule severity: high (triggers category floor), medium (normal), low (informational). Note: 'critical' is intentionally excluded from v0.1 — see spec §A.3"
          },
          "counted_in_score": {
            "type": "boolean",
            "description": "If false, this assertion does not contribute to score calculation"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "UI-only, never a scoring input — see spec §6.1"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "description": "Array of evidence objects justifying the assertion's status — see spec §12.1"
          },
          "conflict": {
            "description": "Present only when status = CONFLICT — see spec §5, §12.2",
            "type": "object",
            "properties": {
              "sides": {
                "minItems": 2,
                "maxItems": 2,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "description": "Evidence source of this conflicting side"
                    },
                    "value": {
                      "type": "string",
                      "description": "The conflicting value from this source"
                    }
                  },
                  "required": [
                    "source",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "description": "Exactly 2 entries describing the disagreeing sides"
              }
            },
            "required": [
              "sides"
            ],
            "additionalProperties": false
          },
          "claim": {
            "type": "string",
            "description": "Human-readable statement being checked (V2, spec v0.3 §12) — e.g. 'Pricing is machine-readable and discoverable by agents'"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of latest evidence capture (V2, spec v0.3 §12) — falls back to assertion build 'timestamp' for evidence-less assertions"
          },
          "review_level": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "automatic",
                  "assisted"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Review routing for fix pipeline (V2, spec v0.3 §12.5): 'automatic' if confidence >= 0.80, 'assisted' if < 0.80, null for NOT_APPLICABLE. NEVER a scoring input — extends §6.1 boundary"
          },
          "age_days": {
            "type": "number",
            "minimum": 0,
            "description": "Days since evidence capture (V2, spec v0.3 §12.4) — computed at read/display time, not stored at scan time"
          },
          "stale": {
            "type": "boolean",
            "description": "Whether this assertion's evidence is stale per source-class freshness thresholds (V2, spec v0.3 §12.4)"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of assertion build time (distinct from verified_at = evidence capture time)"
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Primary source URL for this assertion, if any"
          },
          "reason": {
            "type": "string",
            "description": "Human-readable explanation of the status determination"
          },
          "name": {
            "type": "string",
            "description": "Human-readable rule name"
          },
          "fix": {
            "type": "object",
            "properties": {
              "eligible": {
                "type": "boolean"
              },
              "type": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "eligible",
              "type"
            ],
            "additionalProperties": false,
            "description": "Fix metadata for the fix pipeline"
          }
        },
        "required": [
          "rule_id",
          "rule_version",
          "category",
          "status",
          "severity",
          "counted_in_score",
          "confidence",
          "evidence"
        ],
        "additionalProperties": true,
        "description": "Assertion object — see spec §12. V2 fields (claim, verified_at, review_level, age_days, stale) are optional; legacy fields (timestamp, source_url, reason, name, fix) are emitted by the runtime. additionalProperties: true for forward compat."
      },
      "description": "Array of assertion objects — one per evaluated rule, see spec §12"
    },
    "integrity": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256",
          "description": "Hash algorithm for content hash — always sha256 in v0.1"
        },
        "canonicalization": {
          "type": "string",
          "const": "JCS-RFC8785",
          "description": "JSON Canonicalization Scheme (RFC 8785) — required before hashing"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 of JCS-canonicalized report body (everything except the integrity block itself)"
        },
        "signature": {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "ed25519",
              "description": "Signature algorithm — always ed25519 in v0.1"
            },
            "key_id": {
              "type": "string",
              "description": "Identifier of the public key used for verification — references placeholder key path from KEYS.md (SLICE-32-15)"
            },
            "value": {
              "type": "string",
              "description": "Base64-encoded Ed25519 signature over content_hash"
            }
          },
          "required": [
            "algorithm",
            "key_id",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "algorithm",
        "canonicalization",
        "content_hash",
        "signature"
      ],
      "additionalProperties": false,
      "description": "Integrity block — content hash + Ed25519 signature, see spec §13"
    }
  },
  "required": [
    "report_id",
    "schema_version",
    "ruleset",
    "scope",
    "scanned_at",
    "previous_hash",
    "source_state",
    "score",
    "assertions",
    "integrity"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "http",
            "openapi",
            "json_schema",
            "html",
            "robots",
            "sitemap",
            "github",
            "manual_confirmation",
            "cross"
          ],
          "description": "Evidence variant discriminator — 9-variant discriminated union (spec v0.3 §12.1)"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when this evidence was captured (V2, spec v0.3 §12.1) — propagated from ResponseSnapshot.fetchedAt"
        },
        "source_class": {
          "type": "string",
          "enum": [
            "runtime",
            "machine_readable_spec",
            "machine_readable_guide",
            "official_docs",
            "website_content",
            "ai_inference"
          ],
          "description": "Source hierarchy class (V2, spec v0.3 §12.3): runtime (6) > machine_readable_spec (5) > machine_readable_guide (4) > official_docs (3) > website_content (2) > ai_inference (1)"
        },
        "url": {
          "type": "string",
          "description": "Source URL (http, openapi, json_schema, html, robots, sitemap variants)"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599,
          "description": "HTTP status code (http, robots, sitemap variants)"
        },
        "headers": {
          "type": "object",
          "description": "HTTP response headers (http variant)"
        },
        "content_hash": {
          "type": "string",
          "description": "Content hash (http, html, github variants)"
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Content-Type header value (http, html variants)"
        },
        "resolved_ip": {
          "type": [
            "string",
            "null"
          ],
          "description": "Resolved IP address (http variant)"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "API paths discovered (openapi variant)"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "HTTP methods discovered (openapi variant)"
        },
        "schema_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Schema keys found (json_schema variant)"
        },
        "valid": {
          "type": "boolean",
          "description": "Whether the schema is valid (json_schema variant)"
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Page title (html variant)"
        },
        "allows_all": {
          "type": "boolean",
          "description": "Whether robots.txt allows all crawlers (robots variant)"
        },
        "disallowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Disallowed paths from robots.txt (robots variant)"
        },
        "url_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of URLs in sitemap (sitemap variant)"
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "URLs from sitemap (sitemap variant)"
        },
        "repo": {
          "type": "string",
          "description": "GitHub repository (github variant)"
        },
        "path": {
          "type": "string",
          "description": "File path in GitHub repo (github variant)"
        },
        "last_commit": {
          "type": "string",
          "description": "Last commit hash (github variant)"
        },
        "confirmed_by": {
          "type": "string",
          "description": "Who confirmed this manually (manual_confirmation variant)"
        },
        "confirmed_at": {
          "type": "string",
          "description": "When manual confirmation happened (manual_confirmation variant)"
        },
        "note": {
          "type": "string",
          "description": "Confirmation note (manual_confirmation variant)"
        },
        "sources": {
          "type": "array",
          "description": "Cross-evidence sources (cross variant)"
        },
        "match_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Keys matched in cross-evidence (cross variant)"
        },
        "conflict_reason": {
          "type": "string",
          "description": "Reason for conflict in cross-evidence (cross variant)"
        },
        "source": {
          "type": "string",
          "description": "Legacy evidence source identifier (v0.1 compat — accepted on input, not emitted in V2)"
        },
        "detail": {
          "type": "string",
          "description": "Legacy evidence detail (v0.1 compat — accepted on input, not emitted in V2)"
        }
      },
      "required": [],
      "additionalProperties": true,
      "description": "Evidence object — 9-variant discriminated union (spec v0.3 §12.1). V2 adds captured_at + source_class. Legacy {source, detail} shape accepted on input for backward compat. 'type' is not required to allow legacy evidence shape."
    }
  }
}
