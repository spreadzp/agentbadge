{
  "name": "agentgate",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "build:css": "tailwindcss -i src/input.css -o public/css/tailwind.css --minify",
    "dev:css": "tailwindcss -i src/input.css -o public/css/tailwind.css --watch",
    "build": "bun run build:css && bun build src/server/index.ts --outdir dist --target bun",
    "start": "bun src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scanner": "vitest --run tests/agent-readiness/scanner/",
    "test:rule-engine": "vitest --run tests/agent-readiness/rule-engine/",
    "test:scoring": "vitest --run tests/agent-readiness/scoring/",
    "test:report-integrity": "vitest --run tests/agent-readiness/integrity/",
    "test:cli": "vitest --run tests/agent-readiness/cli/",
    "test:badge": "vitest --run tests/agent-readiness/badge/",
    "test:ci": "vitest --run tests/agent-readiness/ci/",
    "test:agent-knowledge": "vitest --run tests/agent-knowledge-routes.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "seed-medical-tasks": "bun src/scripts/seed-medical-tasks.ts",
    "format": "prettier --write src/ tests/",
    "mcp": "bun src/mcp/entry.ts",
    "hermes": "bun scripts/hermes.ts",
    "generate:agent-readiness-schemas": "bun src/scripts/generate-agent-readiness-schemas.ts",
    "validate:agent-readiness": "bun run generate:agent-readiness-schemas && vitest run tests/agent-readiness-*.test.ts",
    "demo:full-flow": "bun scripts/full-flow-demo.ts",
    "demo:medical-marketplace": "bun scripts/demo-medical-marketplace.ts",
    "push": "git add -A && git commit -m \"$(date +%Y-%m-%d) update\" && git push origin main",
    "deploy": "fly deploy",
    "lighthouse": "lhci autorun",
    "medical-agent": "bun src/agents/cli.ts",
    "medical-agent:task": "bun src/agents/cli.ts --task-id"
  },
  "dependencies": {
    "@agentgate-hedera/hedera-core": "^0.1.10",
    "@agentgate-hedera/mcp": "^0.1.7",
    "@agentgate-hedera/passport": "^0.1.6",
    "@hashgraph/sdk": "^2.55.0",
    "@hono/standard-validator": "^0.3.0",
    "@hono/swagger-ui": "^0.6.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@sentry/node": "^10.67.0",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "@x402/fetch": "^2.19.0",
    "@x402/hedera": "^2.19.0",
    "@x402/hono": "^2.19.0",
    "ethers": "^6.17.0",
    "hono": "^4.7.0",
    "hono-openapi": "^1.3.1",
    "long": "^5.2.0",
    "prom-client": "^15.1.3",
    "protobufjs": "^7.4.0",
    "quansync": "^1.0.0",
    "stripe": "^22.5.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "bun-types": "^1.1.0",
    "eslint": "^9.0.0",
    "lighthouse": "^12.0.0",
    "prettier": "^3.3.0",
    "tailwindcss": "3",
    "typescript": "^5.9.0",
    "vitest": "^2.0.0"
  }
}