{
  "name": "agentgate",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "build": "bun build src/server/index.ts --outdir dist --target bun",
    "start": "bun src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/",
    "mcp": "bun src/mcp/entry.ts",
    "hermes": "bun scripts/hermes.ts",
    "demo:full-flow": "bun scripts/full-flow-demo.ts",
    "demo:medical-marketplace": "bun scripts/demo-medical-marketplace.ts"
  },
  "dependencies": {
    "@agentgate-hedera/hedera-core": "^0.1.4",
    "@agentgate-hedera/mcp": "^0.1.4",
    "@agentgate-hedera/passport": "^0.1.4",
    "@hashgraph/sdk": "^2.55.0",
    "@hono/standard-validator": "^0.3.0",
    "@hono/swagger-ui": "^0.6.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@sentry/node": "^10.67.0",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "@x402/fetch": "^2.19.0",
    "@x402/hedera": "^2.19.0",
    "@x402/hono": "^2.19.0",
    "ethers": "^6.17.0",
    "hono": "^4.7.0",
    "hono-openapi": "^1.3.1",
    "long": "^5.2.0",
    "protobufjs": "^7.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "bun-types": "^1.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.9.0",
    "vitest": "^2.0.0"
  }
}